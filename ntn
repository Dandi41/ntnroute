#!/usr/bin/env bash
# ============================================================
# ntn — NTnRoute.AI device engine for Hermes Agent
# Persistent network device inventory (~/.ntnroute/devices.json)
# + SSH execution via OpenSSH (legacy crypto flags automatic).
# Two session modes:
#   PTY  (ssh -tt + paced plan) -> Cisco/Huawei/Aruba/Ruijie/Arista/Juniper
#   EXEC (ssh -T, stdin pipe)   -> MikroTik RouterOS
# All output is plain text. Errors start with "ERROR:" and exit 1.
# ============================================================
set -o pipefail

NTN_HOME="${NTN_HOME:-$HOME/.ntnroute}"
DB="$NTN_HOME/devices.json"
BACKUP_DIR="$NTN_HOME/backups"
LOCK_FILE="$NTN_HOME/.lock"
TMPBASE="${TMPDIR:-/tmp}"

SSH_OPTS=(
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1,diffie-hellman-group-exchange-sha1
  -o HostKeyAlgorithms=+ssh-rsa
  -o PubkeyAcceptedAlgorithms=+ssh-rsa
  -o Ciphers=+aes128-cbc,3des-cbc
  -o MACs=+hmac-sha1
  -o PreferredAuthentications=password
  -o NumberOfPasswordPrompts=1
)

die() { echo "ERROR: $*" >&2; exit 1; }
umask 077
command -v jq  >/dev/null 2>&1 || die "jq not found"
command -v ssh >/dev/null 2>&1 || die "ssh not found"

mkdir -p "$BACKUP_DIR"
[ -f "$DB" ] || { echo '{"devices":[],"checkpoints":[],"audit":[],"next_id":1}' > "$DB"; chmod 600 "$DB"; }
if command -v flock >/dev/null 2>&1; then exec 9>"$LOCK_FILE"; flock 9; fi

# ---------- JSON helpers ----------
db_write() { # filter [jq-args...] ; atomic write
  local filter=$1; shift
  local tmp err
  tmp=$(mktemp "$TMPBASE/ntn.db.XXXXXX") || die "mktemp failed"
  err=$(mktemp "$TMPBASE/ntn.err.XXXXXX")
  if jq "$filter" "$@" "$DB" > "$tmp" 2>"$err"; then
    mv "$tmp" "$DB"; chmod 600 "$DB"; rm -f "$err"
  else
    cat "$err" >&2; rm -f "$tmp" "$err"; die "failed to write database (jq filter)"
  fi
}

audit() { db_write '.audit = (.audit + [{ts:(now|todate), action:$a, detail:$d}])[-500:]' --arg a "$1" --arg d "$2"; }

resolve_ref() { # ref = display-number | id | ip | hostname -> print id
  jq -r --arg ref "$1" '[.devices[] | select((.id|tostring)==$ref or .ip==$ref or ((.hostname|ascii_downcase)==($ref|ascii_downcase)))] | .[0].id // empty' "$DB"
}

resolve_number() { # display row number (1-based) OR id -> print id
  jq -r --arg r "$1" '.devices | to_entries[] | select(((.key+1)|tostring)==$r or (.value.id|tostring)==$r) | .value.id' "$DB" | head -1
}

device_by_id() { jq --argjson id "$1" '.devices[] | select(.id==$id)' "$DB"; }

# ---------- brand differences ----------
norm_brand() { case "${1,,}" in cisco) echo Cisco;; huawei) echo Huawei;; aruba) echo Aruba;; arista) echo Arista;; ruijie) echo Ruijie;; juniper) echo Juniper;; fortinet|fortigate) echo Fortinet;; mikrotik) echo Mikrotik;; *) echo "${1^}";; esac; }
norm_type()  { case "${1,,}" in router) echo Router;; switch) echo Switch;; olt) echo OLT;; firewall) echo Firewall;; ap|accesspoint|access-point) echo AP;; *) echo "${1^}";; esac; }

is_exec_brand() { [ "$1" = "Mikrotik" ]; }

paging_cmd()   { case "$1" in Huawei) echo "screen-length 0 temporary";; Aruba) echo "no page";; Juniper) echo "set cli screen-length 0";; Mikrotik|Fortinet) :;; *) echo "terminal length 0";; esac; }
secret_cmd()   { case "$1" in Huawei) echo super;; Fortinet) :;; *) echo enable;; esac; }
config_enter() { case "$1" in Juniper) echo configure;; Huawei) echo "system-view";; Mikrotik|Fortinet) :;; *) echo "configure terminal";; esac; }
config_leave() { case "$1" in Juniper) :;; Huawei) echo return;; Mikrotik|Fortinet) :;; *) echo end;; esac; }
save_lines()   { case "$1" in Huawei) echo save; echo Y;; Juniper) echo commit; echo "exit configuration-mode";; Mikrotik|Fortinet) :;; *) echo "write memory";; esac; }
save_delay()   { case "$1" in Juniper) echo 15;; *) echo 4;; esac; }

config_cmd_show() { # full config pull command
  case "$1" in
    Mikrotik) echo "/export";;
    Huawei)   echo "display current-configuration";;
    Juniper)  echo "show configuration | display set";;
    Fortinet) echo "show full-configuration";;
    *)        echo "show running-config";;
  esac
}
hostname_cmd_show() { # hostname pull command
  case "$1" in
    Mikrotik) echo "/system identity print";;
    Huawei)   echo "display current-configuration | include sysname";;
    Juniper)  echo "show configuration | display set | match host-name";;
    Fortinet) echo "get system status";;
    *)        echo "show running-config | include hostname";;
  esac
}

# per-brand error patterns (used with grep -E)
err_pattern() {
  case "$1" in
    Mikrotik) echo '^(invalid value|no such item|syntax error|expected |bad command|ambiguous|failure:|script error|\s+error:)';;
    Huawei)   echo '(^%|^\s*(Error|Unrecognized|Wrong parameter|Incomplete command))';;
    Juniper)  echo '(^%|error:|syntax error|unknown command|invalid value)';;
    Fortinet) echo '(command parse error|Unknown action|Unknown attribute|unrecognized)';;
    *)        echo '(^%|Invalid input|Incomplete command|Ambiguous|syntax error|Unknown command|^Error)';;
  esac
}

# ---------- SSH session engine: PTY mode (interactive CLI) ----------
# plan file: lines "delay<TAB>command" (empty command = just wait)
run_session() { # ip port user pass plan_file out_file timeout_s
  local ip=$1 port=$2 user=$3 pass=$4 plan=$5 out=$6 tmo=$7
  local work rc
  work=$(mktemp -d "$TMPBASE/ntn.ssh.XXXXXX") || die "mktemp failed"
  printf '#!/bin/bash\nprintf "%%s\\n" "$NTN_PW"\n' > "$work/askpass.sh"
  chmod 700 "$work/askpass.sh"
  (
    while IFS=$'\t' read -r delay cmd; do
      sleep "$delay"
      if [ -n "$cmd" ]; then printf '%s\n' "$cmd"; fi
    done < "$plan"
  ) | NTN_PW="$pass" SSH_ASKPASS="$work/askpass.sh" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 \
      timeout "$tmo" ssh -tt "${SSH_OPTS[@]}" -p "$port" "$user@$ip" 2>&1 \
    | tr -d '\r' > "$out"
  rc=${PIPESTATUS[1]}
  chmod 600 "$out" 2>/dev/null
  rm -rf "$work"
  return "$rc"
}

# ---------- SSH session engine: EXEC mode (MikroTik RouterOS) ----------
# RouterOS runs commands from stdin at login (exec channel).
# Far more reliable than interactive mode: no banner/paging/preparation.
run_exec_mode() { # ip port user pass commands_file out_file timeout_s
  local ip=$1 port=$2 user=$3 pass=$4 cmds=$5 out=$6 tmo=$7
  local work rc
  work=$(mktemp -d "$TMPBASE/ntn.ssh.XXXXXX") || die "mktemp failed"
  printf '#!/bin/bash\nprintf "%%s\\n" "$NTN_PW"\n' > "$work/askpass.sh"
  chmod 700 "$work/askpass.sh"
  NTN_PW="$pass" SSH_ASKPASS="$work/askpass.sh" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 \
    timeout "$tmo" ssh -T "${SSH_OPTS[@]}" -p "$port" "$user@$ip" < "$cmds" 2>&1 \
    | tr -d '\r' | grep -v '^Warning: Permanently added' > "$out"
  rc=${PIPESTATUS[0]}
  chmod 600 "$out" 2>/dev/null
  rm -rf "$work"
  return "$rc"
}

plan_timeout() { awk -F'\t' '{s+=$1} END{printf "%d", s+30}' "$1"; }

# extract one command's output from a PTY transcript: between the command echo and the next prompt
extract_cmd_output() { # command transcript
  awk -v cmd="$2" '
    BEGIN { L=length(cmd) }
    !found {
      if (length($0) >= L && substr($0, length($0)-L+1) == cmd) found=1
      next
    }
    /^(<[^<>]{1,63}>|\[[^][]+\]|[A-Za-z0-9_.@()-]{1,63}[>#]|[A-Za-z0-9_.@()-]{1,63} #) ?$/ { exit }
    { print }
  ' "$1"
}

cmd_wait() { case "$1" in *running-config*|*current-configuration*|*"show configuration"*|*full-configuration*|*"get system status"*|*"show tech"*|*"display version"*) echo 10;; *) echo 3;; esac; }

auth_failed() { grep -qE "Permission denied|Authentication failed|no matching|Connection (refused|timed out)|No route to host" "$1" 2>/dev/null; }

build_exec_plan() { # brand secret plan_file cmd...
  local brand=$1 secret=$2 plan=$3; shift 3
  : > "$plan"
  printf '4\t\n' >> "$plan"
  if [ -n "$secret" ] && [ -n "$(secret_cmd "$brand")" ]; then printf '2\t%s\n' "$(secret_cmd "$brand")" >> "$plan"; printf '2\t%s\n' "$secret" >> "$plan"; fi
  printf '2\t%s\n' "$(paging_cmd "$brand")" >> "$plan"
  local c
  for c in "$@"; do printf '%s\t%s\n' "$(cmd_wait "$c")" "$c" >> "$plan"; done
  printf '2\texit\n' >> "$plan"
  if [ -n "$secret" ]; then printf '2\texit\n' >> "$plan"; fi
  printf '2\t\n' >> "$plan"
}

# ---------- config / hostname pull (mode-aware) ----------
pull_config() { # ip port user pass secret brand out_file -> exit code; out contains config only
  local ip=$1 port=$2 user=$3 pass=$4 secret=$5 brand=$6 out=$7
  local rc
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(mktemp "$TMPBASE/ntn.cmd.XXXXXX")
    printf '%s\n' "$(config_cmd_show "$brand")" > "$cfile"
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" 90
    rc=$?
    rm -f "$cfile"
  else
    local plan transcript
    plan=$(mktemp "$TMPBASE/ntn.plan.XXXXXX")
    transcript=$(mktemp "$TMPBASE/ntn.tr.XXXXXX")
    build_exec_plan "$brand" "$secret" "$plan" "$(config_cmd_show "$brand")"
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$transcript" "$(plan_timeout "$plan")"
    rc=$?
    rm -f "$plan"
    extract_cmd_output "$transcript" "$(config_cmd_show "$brand")" > "$out"
    if auth_failed "$transcript" || [ ! -s "$out" ]; then cp "$transcript" "$out"; fi
    rm -f "$transcript"
  fi
  return $rc
}

pull_hostname() { # ip port user pass secret brand -> stdout hostname ('' on failure)
  local ip=$1 port=$2 user=$3 pass=$4 secret=$5 brand=$6
  local out; out=$(mktemp "$TMPBASE/ntn.hn.XXXXXX")
  local hn=""
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(mktemp "$TMPBASE/ntn.cmd.XXXXXX")
    printf '%s\n' "$(hostname_cmd_show "$brand")" > "$cfile"
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" 60 || true
    rm -f "$cfile"
    hn=$(awk -F': *' '/^ *name:/{print $2; exit}' "$out" | tr -d '\r')
  else
    local plan; plan=$(mktemp "$TMPBASE/ntn.plan.XXXXXX")
    build_exec_plan "$brand" "$secret" "$plan" "$(hostname_cmd_show "$brand")"
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$out" "$(plan_timeout "$plan")" || true
    rm -f "$plan"
    case "$brand" in
      Huawei)   hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk 'tolower($1)=="sysname"{print $2; exit}');;
      Juniper)  hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk '$3=="host-name"{print $4; exit}');;
      Fortinet) hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk -F': *' 'tolower($1)=="hostname"{print $2; exit}');;
      *)        hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk 'tolower($1)=="hostname"{print $2; exit}');;
    esac
  fi
  rm -f "$out"
  printf '%s' "$hn"
}

# ---------- commands: list / show / add / remove ----------
cmd_list() {
  local n; n=$(jq '.devices|length' "$DB")
  if [ "$n" -eq 0 ]; then echo "(no devices yet — add one with: ntn add <IP> <Port> <Username> <Password> <Type> <Brand> [Secret])"; return 0; fi
  echo "Devices ($n):"
  jq -r '.devices | to_entries[] | "\(.key+1). [id \(.value.id)] \(.value.hostname) — \(.value.ip):\(.value.port) (\(.value.brand) \(.value.type)) | last sync: \(.value.last_sync // "-")"' "$DB"
}

cmd_show() {
  [ $# -ge 1 ] || die "usage: ntn show <ref> [--reveal]"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  local reveal=0; [ "${2:-}" = "--reveal" ] && reveal=1
  device_by_id "$id" | jq -r --argjson reveal "$reveal" '
    "hostname   : " + .hostname,
    "id         : " + (.id|tostring),
    "ip:port    : " + .ip + ":" + (.port|tostring),
    "brand/type : " + .brand + " " + .type,
    "username   : " + .username,
    "password   : " + (if $reveal==1 then .password else "****" end),
    "secret     : " + (if .secret=="" then "(none)" elif $reveal==1 then .secret else "****" end),
    "added_at   : " + (.added_at // "-"),
    "last_sync  : " + (.last_sync // "-"),
    "check_point: " + (if .check_point=="" then "(empty)" else ((.check_point|split("\n")|length)|tostring) + " lines" end),
    "--- config_list ---",
    (.config_list // "(empty)")'
}

cmd_add() {
  [ $# -ge 6 ] || die "usage: ntn add <IP> <Port> <Username> <Password> <Type> <Brand> [Secret]"
  local ip=$1 port=$2 user=$3 pass=$4 type=$5 brand=$6 secret=${7:-}
  [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "invalid IP: $ip"
  [[ $port =~ ^[0-9]+$ ]] || die "port must be a number: $port"
  brand=$(norm_brand "$brand"); type=$(norm_type "$type")
  local dup; dup=$(jq -r --arg ip "$ip" '.devices[] | select(.ip==$ip) | .id' "$DB")
  [ -z "$dup" ] || die "IP $ip already registered (id $dup). Remove it first: ntn remove <number>"

  echo "Testing SSH connection to $ip:$port (user $user, $brand $type) ..."
  local cfgfile probe rc
  cfgfile=$(mktemp "$TMPBASE/ntn.cfg.XXXXXX")
  probe=$(mktemp "$TMPBASE/ntn.probe.XXXXXX")
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$probe"
  rc=$?
  if [ $rc -ne 0 ] || auth_failed "$probe"; then
    grep -E "Permission denied|no matching|refused|timed out|No route" "$probe" | head -3 >&2
    rm -f "$cfgfile" "$probe"; audit "add-failed" "$ip (auth/connection failed)"
    die "connection/auth failed (exit $rc). Device NOT saved."
  fi
  mv "$probe" "$cfgfile"
  if [ ! -s "$cfgfile" ]; then
    rm -f "$cfgfile"
    audit "add-failed" "$ip (empty config)"
    die "device config is empty — device NOT saved."
  fi

  local hostname; hostname=$(pull_hostname "$ip" "$port" "$user" "$pass" "$secret" "$brand")
  [ -n "$hostname" ] || hostname="$ip"

  local id; id=$(jq -r '.next_id' "$DB")
  local dev
  dev=$(jq -n --argjson id "$id" --arg hostname "$hostname" --arg ip "$ip" --argjson port "$port" \
        --arg username "$user" --arg password "$pass" --arg secret "$secret" \
        --arg brand "$brand" --arg type "$type" --rawfile cfg "$cfgfile" \
        '{id:$id, hostname:$hostname, ip:$ip, port:$port, username:$username, password:$password,
          secret:$secret, brand:$brand, type:$type, config_list:$cfg, check_point:"",
          added_at:(now|todate), last_sync:(now|todate)}') || { rm -f "$cfgfile"; die "failed to create device entry"; }
  local bk; bk="$BACKUP_DIR/${hostname}-$(date +%Y%m%d-%H%M%S)-added.cfg"
  cp "$cfgfile" "$bk"
  db_write '.devices += [$d] | .next_id += 1' --argjson d "$dev"
  rm -f "$cfgfile"
  audit "add" "$hostname ($ip) $brand $type"
  echo "OK: device added"
  echo "  id       : $id"
  echo "  hostname : $hostname"
  echo "  ip:port  : $ip:$port"
  echo "  brand    : $brand $type"
  echo "  config   : $(wc -l < "$bk") lines in config_list (copy: $bk)"
}

cmd_remove() {
  [ $# -ge 1 ] || die "usage: ntn remove <number|id>  (see list: ntn list)"
  local id; id=$(resolve_number "$1"); [ -n "$id" ] || die "no device with number/id $1"
  local label; label=$(device_by_id "$id" | jq -r '.hostname + " (" + .ip + ")"')
  db_write '.devices = [.devices[] | select(.id != $id)]' --argjson id "$id"
  audit "remove" "$label"
  echo "OK: device removed → $label"
}

# ---------- commands: ping / exec / sync ----------
cmd_ping() {
  [ $# -ge 1 ] || die "usage: ntn ping <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  local ip; ip=$(device_by_id "$id" | jq -r '.ip')
  ping -c 3 -W 2 "$ip" 2>&1 | tail -2
}

run_device_commands() { # ip port user pass secret brand out_file timeout cmd... -> rc
  local ip=$1 port=$2 user=$3 pass=$4 secret=$5 brand=$6 out=$7 tmo=$8; shift 8
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(mktemp "$TMPBASE/ntn.cmd.XXXXXX")
    printf '%s\n' "$@" > "$cfile"
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" "$tmo"
    local rc=$?
    rm -f "$cfile"
    return $rc
  else
    local plan; plan=$(mktemp "$TMPBASE/ntn.plan.XXXXXX")
    build_exec_plan "$brand" "$secret" "$plan" "$@"
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$out" "$(plan_timeout "$plan")"
    local rc=$?
    rm -f "$plan"
    return $rc
  fi
}

cmd_exec() {
  [ $# -ge 2 ] || die "usage: ntn exec <ref> <cmd> [cmd2 ...]"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  shift
  local dev ip port user pass secret brand out rc
  dev=$(device_by_id "$id")
  ip=$(jq -r '.ip' <<<"$dev");      port=$(jq -r '.port' <<<"$dev")
  user=$(jq -r '.username' <<<"$dev"); pass=$(jq -r '.password' <<<"$dev")
  secret=$(jq -r '.secret' <<<"$dev"); brand=$(jq -r '.brand' <<<"$dev")
  out=$(mktemp "$TMPBASE/ntn.out.XXXXXX")
  run_device_commands "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$out" 120 "$@"
  rc=$?
  if [ $rc -ne 0 ] || auth_failed "$out"; then
    grep -E "Permission denied|no matching|refused|timed out|No route" "$out" | head -3 >&2
    rm -f "$out"; die "execution failed (exit $rc)"
  fi
  cat "$out"
  local lines; lines=$(wc -l < "$out")
  if [ "$lines" -gt 400 ]; then echo "... (transcript $lines lines; full output: $out)"; else rm -f "$out"; fi
  return 0
}

sync_one() { # id
  local id=$1 dev ip port user pass secret brand hostname
  dev=$(device_by_id "$id")
  ip=$(jq -r '.ip' <<<"$dev");      port=$(jq -r '.port' <<<"$dev")
  user=$(jq -r '.username' <<<"$dev"); pass=$(jq -r '.password' <<<"$dev")
  secret=$(jq -r '.secret' <<<"$dev"); brand=$(jq -r '.brand' <<<"$dev")
  hostname=$(jq -r '.hostname' <<<"$dev")
  local cfgfile rc
  cfgfile=$(mktemp "$TMPBASE/ntn.cfg.XXXXXX")
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$cfgfile"
  rc=$?
  if [ $rc -ne 0 ] || auth_failed "$cfgfile"; then
    rm -f "$cfgfile"; echo "FAILED sync $hostname ($ip): connection/auth"; audit "sync-failed" "$hostname ($ip)"; return 1
  fi
  if [ ! -s "$cfgfile" ]; then rm -f "$cfgfile"; echo "FAILED sync $hostname: empty config output"; audit "sync-failed" "$hostname ($ip)"; return 1; fi
  cp "$cfgfile" "$BACKUP_DIR/${hostname}-$(date +%Y%m%d-%H%M%S).cfg"
  db_write '(.devices[] | select(.id==$id)).config_list = $cfg
            | (.devices[] | select(.id==$id)).last_sync = (now|todate)' \
           --argjson id "$id" --rawfile cfg "$cfgfile"
  rm -f "$cfgfile"
  audit "sync" "$hostname ($ip)"
  echo "OK sync $hostname ($ip)"
}

cmd_sync() {
  [ $# -ge 1 ] || die "usage: ntn sync <ref|all>"
  if [ "$1" = "all" ]; then
    local ids id ok=0 fail=0
    ids=$(jq -r '.devices[].id' "$DB")
    [ -n "$ids" ] || { echo "(no devices yet)"; return 0; }
    for id in $ids; do if sync_one "$id"; then ok=$((ok+1)); else fail=$((fail+1)); fi; done
    echo "Done: $ok succeeded, $fail failed"
  else
    local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
    sync_one "$id"
  fi
}

# ---------- MikroTik script normalization ----------
# RouterOS exec-mode (ssh -T) does NOT keep context between lines:
#   /interface ethernet
#   set [ find ... ] comment=X
# the first line runs alone, the second becomes "set ..." without a path -> syntax error.
# Fix: merge a menu-path line (/xxx) into the next command as one line.
mt_normalize() { # in_file out_file -> print count of effective commands
  local line path="" n=0 tok is_path
  # RouterOS verbs: if one appears in the line, the line is a full command, not a path
  local verbs=" add set remove print export import enable disable find get unset move reset edit check run send ping traceroute reboot shutdown save load backup restore monitor comment export "
  : > "$2"
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue;; esac
    line=$(sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' <<<"$line")
    case "$line" in
      /*)
        is_path=1
        # contains '=' or '[' -> clearly a full command
        case "$line" in *=*|*'['*) is_path=0;; esac
        if [ "$is_path" -eq 1 ]; then
          for tok in $line; do
            case "$verbs" in *" $tok "*) is_path=0; break;; esac
          done
        fi
        if [ "$is_path" -eq 1 ]; then
          path="$line"; continue
        fi
        printf '%s\n' "$line" >> "$2"; path=""; n=$((n+1)); continue
        ;;
      *)
        if [ -n "$path" ]; then
          printf '%s %s\n' "$path" "$line" >> "$2"
        else
          printf '%s\n' "$line" >> "$2"
        fi
        n=$((n+1))
        ;;
    esac
  done < "$1"
  printf '%s' "$n"
}

# ---------- post-check verification ----------
MISSING=(); UNCHECKED=()

# MikroTik: /export reorders arguments (order and line folding change),
# so match each key=value token against the export with spaces/backslashes stripped.
verify_mikrotik() { # newcfg script
  local newcfg=$1 script=$2
  # flatten: strip spaces, newlines, backslashes, and quotes from both sides
  local flat; flat=$(tr -d ' \t\r\n\\"' < "$newcfg")
  local line word tok checked destructive
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue;; esac
    # Destructive commands (remove/unset/disable/reset) remove their own object,
    # so their tokens must NOT appear in the export. Reverse verification
    # cannot be automated here -> record UNCHECKED, not MISSING.
    destructive=0
    case " $line " in
      *" remove "*|*" unset "*|*" disable "*|*" reset "*) destructive=1;;
    esac
    if [ "$destructive" -eq 1 ]; then
      UNCHECKED+=("$line (destructive command — check manually)")
      continue
    fi
    checked=0
    for word in $line; do
      case "$word" in
        *=*)
          tok="${word//\"/}"
          checked=$((checked+1))
          # RouterOS drops empty values from /export (e.g. comment=""),
          # so empty-value tokens cannot be verified -> record UNCHECKED only.
          case "$tok" in
            *=) UNCHECKED+=("$line :: $tok (empty value absent from export)");;
            *)  case "$flat" in *"$tok"*) ;; *) MISSING+=("$line :: token $tok");; esac;;
          esac
          ;;
      esac
    done
    [ "$checked" -eq 0 ] && UNCHECKED+=("$line")
  done < "$script"
}

# Other brands: match the normalized line exactly.
verify_exact() { # newcfg script
  local newcfg=$1 script=$2
  local normfile; normfile=$(mktemp "$TMPBASE/ntn.norm.XXXXXX")
  sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' "$newcfg" > "$normfile"
  local line n
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    n=$(sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' <<<"$line")
    case "$n" in ''|'!'*|'#'*|end|exit|'configure terminal'|configure) continue;; esac
    if [[ $n == "no "* ]]; then
      UNCHECKED+=("$n")
    else
      grep -Fxq -- "$n" "$normfile" || MISSING+=("$n")
    fi
  done < "$script"
  rm -f "$normfile"
}

# ---------- apply config ----------
apply_config() { # id script_file reason -> 0 on success
  local id=$1 script=$2 reason=$3
  [ -s "$script" ] || die "script file is empty or missing: $script"
  local dev ip port user pass secret brand hostname
  dev=$(device_by_id "$id")
  ip=$(jq -r '.ip' <<<"$dev");      port=$(jq -r '.port' <<<"$dev")
  user=$(jq -r '.username' <<<"$dev"); pass=$(jq -r '.password' <<<"$dev")
  secret=$(jq -r '.secret' <<<"$dev"); brand=$(jq -r '.brand' <<<"$dev")
  hostname=$(jq -r '.hostname' <<<"$dev")
  local ts; ts=$(date +%Y%m%d-%H%M%S)

  # 1) pre-change snapshot (mandatory; abort on failure)
  local precfg="$BACKUP_DIR/${hostname}-${ts}-pre.cfg"
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$precfg" || true
  if [ ! -s "$precfg" ] || auth_failed "$precfg"; then
    rm -f "$precfg"
    die "failed to pull pre-change config (aborting for safety)"
  fi
  echo "Snapshot pre-change: $precfg"

  # 2) apply
  local out rc nlines eff_script
  out=$(mktemp "$TMPBASE/ntn.out.XXXXXX")
  # effective script: for MikroTik, normalized into full-path one-liners
  eff_script=$(mktemp "$TMPBASE/ntn.eff.XXXXXX")
  if is_exec_brand "$brand"; then
    nlines=$(mt_normalize "$script" "$eff_script")
  else
    cp "$script" "$eff_script"
    nlines=$(grep -cve '^\s*$' -e '^!' "$script")
  fi
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(mktemp "$TMPBASE/ntn.cmd.XXXXXX")
    cp "$eff_script" "$cfile"
    echo "Applying $nlines commands via RouterOS exec-mode ..."
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" 120
    rc=$?
    rm -f "$cfile"
  else
    local plan; plan=$(mktemp "$TMPBASE/ntn.plan.XXXXXX")
    {
      printf '4\t\n'
      if [ -n "$secret" ] && [ -n "$(secret_cmd "$brand")" ]; then printf '2\t%s\n' "$(secret_cmd "$brand")"; printf '2\t%s\n' "$secret"; fi
      printf '2\t%s\n' "$(paging_cmd "$brand")"
      printf '2\t%s\n' "$(config_enter "$brand")"
      while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        case "$line" in ''|'!'*) continue;; esac
        printf '1\t%s\n' "$line"
      done < "$script"
      printf '2\t%s\n' "$(config_leave "$brand")"
      local s
      while IFS= read -r s; do [ -n "$s" ] && printf '%s\t%s\n' "$(save_delay "$brand")" "$s"; done < <(save_lines "$brand")
      printf '3\texit\n'
      if [ -n "$secret" ]; then printf '2\texit\n'; fi
      printf '2\t\n'
    } > "$plan"
    echo "Applying script ($(grep -cve '^\s*$' -e '^!' "$script") effective lines) via interactive CLI ..."
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$out" "$(plan_timeout "$plan")"
    rc=$?
    rm -f "$plan"
  fi

  if auth_failed "$out"; then
    rm -f "$out"; audit "config-failed" "$hostname ($ip): session dropped / auth failed"
    die "session dropped or auth failed during apply. Check the device manually; pre-change config saved at $precfg"
  fi
  # exit != 0 in RouterOS exec-mode means a command was rejected (syntax/invalid value),
  # not a dropped session — fall through to error detection below so the message is accurate.
  if [ $rc -ne 0 ] && ! is_exec_brand "$brand"; then
    rm -f "$out"; audit "config-failed" "$hostname ($ip): session dropped during apply (exit $rc)"
    die "session dropped during apply (exit $rc). Check the device manually; pre-change config saved at $precfg"
  fi
  local errors
  errors=$(grep -E "$(err_pattern "$brand")" "$out" | head -10)
  if [ -z "$errors" ] && [ $rc -ne 0 ] && is_exec_brand "$brand"; then
    # RouterOS sometimes prints a single error line without a known prefix
    errors=$(grep -vE '^\s*$' "$out" | head -5)
  fi

  # 3) post-check: pull the new config, verify the script contents are present
  local newcfg="$BACKUP_DIR/${hostname}-${ts}-post.cfg"
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$newcfg" || true

  MISSING=(); UNCHECKED=()
  if is_exec_brand "$brand"; then verify_mikrotik "$newcfg" "$eff_script"; else verify_exact "$newcfg" "$script"; fi
  rm -f "$eff_script"

  echo "--- execution result ---"
  if [ -n "$errors" ]; then echo "Device errors:"; echo "$errors"; else echo "Device errors: none"; fi
  echo "Lines not found in new config: ${#MISSING[@]}"
  [ ${#MISSING[@]} -gt 0 ] && printf '  - %s\n' "${MISSING[@]}"
  echo "Lines needing manual check (heuristic): ${#UNCHECKED[@]}"
  if [ ${#UNCHECKED[@]} -gt 0 ] && [ ${#UNCHECKED[@]} -le 5 ]; then printf '  - %s\n' "${UNCHECKED[@]}"; fi

  if [ -z "$errors" ] && [ ${#MISSING[@]} -eq 0 ] && [ -s "$newcfg" ]; then
    db_write '(.devices[] | select(.id==$id)).config_list = $cfg
              | (.devices[] | select(.id==$id)).last_sync = (now|todate)' \
             --argjson id "$id" --rawfile cfg "$newcfg"
    audit "config-ok" "$hostname ($ip): $reason"
    echo "STATUS: SUCCESS — config_list updated"
    return 0
  else
    audit "config-failed" "$hostname ($ip): $reason"
    echo "STATUS: FAILED — config_list NOT changed. Pre-change config: $precfg"
    return 1
  fi
}

cmd_config() {
  local ref="" script="" rollback="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --script) script=$2; shift 2;;
      --rollback) rollback=$2; shift 2;;
      --reason) reason=$2; shift 2;;
      *) [ -z "$ref" ] && ref=$1 || die "unknown argument: $1"; shift;;
    esac
  done
  [ -n "$ref" ] && [ -n "$script" ] || die "usage: ntn config <ref> --script <file> [--rollback <file>] [--reason <text>]"
  [ -n "$reason" ] || reason="(no reason given)"
  local id; id=$(resolve_ref "$ref"); [ -n "$id" ] || die "device not found: $ref"
  local hostname; hostname=$(device_by_id "$id" | jq -r '.hostname')
  local ts; ts=$(date +%Y%m%d-%H%M%S)
  local rbfile="$BACKUP_DIR/${hostname}-${ts}-rollback.cmd"

  if [ -n "$rollback" ]; then
    [ -s "$rollback" ] || die "rollback file missing/empty: $rollback"
    cp "$rollback" "$rbfile"
  else
    : > "$rbfile"
  fi

  if apply_config "$id" "$script" "$reason"; then
    if [ -n "$rollback" ]; then
      db_write '(.devices[] | select(.id==$id)).check_point = $rb' --argjson id "$id" --rawfile rb "$rbfile"
    fi
    db_write '.checkpoints = (.checkpoints + [{ts:(now|todate), hostname:$h, reason:$r, rollback_file:$f}])[-200:]' \
             --arg h "$hostname" --arg r "$reason" --arg f "$rbfile"
    if [ -n "$rollback" ]; then
      echo "Rollback script saved → check_point column + $rbfile"
    else
      echo "WARNING: no rollback script; only the pre-change snapshot in backups/"
    fi
  else
    die "apply failed — fix the script and retry, or restore manually from the pre-change snapshot in $BACKUP_DIR"
  fi
}

cmd_rollback() {
  [ $# -ge 1 ] || die "usage: ntn rollback <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  local rb hostname
  rb=$(device_by_id "$id" | jq -r '.check_point')
  hostname=$(device_by_id "$id" | jq -r '.hostname')
  [ -n "$rb" ] || die "check_point empty for $hostname — nothing to roll back"
  local rbtmp; rbtmp=$(mktemp "$TMPBASE/ntn.rb.XXXXXX")
  printf '%s\n' "$rb" > "$rbtmp"
  echo "Running rollback for $hostname ..."
  if apply_config "$id" "$rbtmp" "ROLLBACK"; then
    db_write '(.devices[] | select(.id==$id)).check_point = ""' --argjson id "$id"
    audit "rollback" "$hostname"
    echo "STATUS: ROLLBACK SUCCESS — check_point cleared"
  else
    rm -f "$rbtmp"
    die "rollback failed — check manually; snapshots are in $BACKUP_DIR"
  fi
  rm -f "$rbtmp"
}

cmd_checkpoints() {
  [ $# -ge 1 ] || die "usage: ntn checkpoints <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  local hostname; hostname=$(device_by_id "$id" | jq -r '.hostname')
  local n; n=$(jq --arg h "$hostname" '[.checkpoints[] | select(.hostname==$h)] | length' "$DB")
  echo "Checkpoint history for $hostname ($n entries, newest last):"
  jq -r --arg h "$hostname" '[.checkpoints[] | select(.hostname==$h)][-10:][] | "  \(.ts) — \(.reason)\n    rollback file: \(.rollback_file)"' "$DB"
}

cmd_audit() {
  local n=${1:-20}
  jq -r --argjson n "$n" '.audit[-$n:][] | "\(.ts)  \(.action)  \(.detail)"' "$DB"
}

usage() {
  cat <<'EOF'
ntn — NTnRoute.AI device engine
  ntn list                                   numbered device list
  ntn add <IP> <Port> <User> <Pass> <Type> <Brand> [Secret]
                                             tests the connection first, pulls hostname+config, then saves
  ntn show <ref> [--reveal]                  device details (ref: number|id|ip|hostname)
  ntn remove <number|id>                     remove a device
  ntn ping <ref>                             ICMP test, 3 packets
  ntn exec <ref> <cmd> [cmd2 ...]            run CLI commands (read-only recommended)
  ntn sync <ref|all>                         pull config -> config_list + backup
  ntn config <ref> --script <file> [--rollback <file>] [--reason <text>]
                                             pre snapshot -> apply -> verify -> update DB
  ntn rollback <ref>                         apply the check_point script
  ntn checkpoints <ref>                      checkpoint history
  ntn audit [N]                              last N audit entries (default 20)

Brands: Cisco, Huawei, Aruba, Arista, Ruijie, Juniper, Mikrotik, Fortinet.
Mikrotik -> exec-mode (ssh -T, /export, no write memory).
Other brands -> interactive CLI (ssh -tt) with paging + automatic save.
EOF
}

main() {
  local sub=${1:-help}; shift || true
  case "$sub" in
    list) cmd_list;;
    add) cmd_add "$@";;
    show) cmd_show "$@";;
    remove) cmd_remove "$@";;
    ping) cmd_ping "$@";;
    exec) cmd_exec "$@";;
    sync) cmd_sync "$@";;
    config) cmd_config "$@";;
    rollback) cmd_rollback "$@";;
    checkpoints) cmd_checkpoints "$@";;
    audit) cmd_audit "$@";;
    help|--help|-h) usage;;
    *) usage; die "unknown command: $sub";;
  esac
}

main "$@"
