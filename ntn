#!/usr/bin/env bash
# ============================================================
# ntn — NTnRoute.AI device engine for Hermes Agent
# Persistent network device inventory (~/.ntnroute/devices.json)
# + SSH execution via OpenSSH (legacy crypto flags automatic).
# Two session modes:
#   PTY  (ssh -tt + paced plan) -> Cisco/Huawei/Aruba/Ruijie/Arista/Juniper
#   EXEC (ssh -T, stdin pipe)   -> MikroTik RouterOS
# All output is plain text. Errors start with "ERROR:" and exit 1.
# ============================================================
set -o pipefail

NTN_HOME="${NTN_HOME:-$HOME/.ntnroute}"
# self-provisioned binaries (jq.exe installed by install.sh on Windows)
case ":$PATH:" in
  *":$NTN_HOME/bin:"*) ;;
  *) PATH="$NTN_HOME/bin:$PATH" ;;
esac
BRANDS_FILE="$NTN_HOME/brands.json"
DB="$NTN_HOME/devices.json"
BACKUP_DIR="$NTN_HOME/backups"
LOCK_FILE="$NTN_HOME/.lock"
TMPBASE="${TMPDIR:-/tmp}"

# Every temporary file is registered at creation and removed on ANY way out —
# normal exit, die(), or a kill signal — so aborted runs leave no litter.
TMPFILES=""
tmpfile() {
  local t; t=$(mktemp "$TMPBASE/$1") || die "mktemp failed"
  TMPFILES="$TMPFILES $t"; printf '%s' "$t"
}
tmpdir() {
  local t; t=$(mktemp -d "$TMPBASE/$1") || die "mktemp failed"
  TMPFILES="$TMPFILES $t"; printf '%s' "$t"
}
cleanup_tmp() { [ -n "$TMPFILES" ] && rm -rf $TMPFILES 2>/dev/null; TMPFILES=""; }
trap 'cleanup_tmp' EXIT
trap 'cleanup_tmp; exit 143' TERM
trap 'cleanup_tmp; exit 130' INT
trap 'cleanup_tmp; exit 129' HUP

SSH_OPTS=(
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1,diffie-hellman-group-exchange-sha1
  -o HostKeyAlgorithms=+ssh-rsa
  -o PubkeyAcceptedAlgorithms=+ssh-rsa
  -o Ciphers=+aes128-cbc,3des-cbc
  -o MACs=+hmac-sha1
  -o PreferredAuthentications=password
  -o NumberOfPasswordPrompts=1
)

PENDING_AUDIT=""   # set while a config apply is in flight; flushed as config-aborted by die()
TRANSACTION_PRE=""
TRANSACTION_FINAL=""
die() { if [ -n "$PENDING_AUDIT" ]; then local p="$PENDING_AUDIT"; PENDING_AUDIT=""; audit_settle; audit "config-aborted" "$p" 2>/dev/null; fi; echo "ERROR: $*" >&2; exit 1; }
umask 077
command -v jq  >/dev/null 2>&1 || die "jq not found"
command -v ssh >/dev/null 2>&1 || die "ssh not found"
TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
[ -n "$TIMEOUT_BIN" ] || die "timeout not found (GNU coreutils) — macOS: brew install coreutils — Windows: install Git for Windows (includes timeout)"

mkdir -p "$BACKUP_DIR"
[ -f "$DB" ] || { echo '{"devices":[],"checkpoints":[],"audit":[],"next_id":1}' > "$DB"; chmod 600 "$DB"; }
if command -v flock >/dev/null 2>&1; then exec 9>"$LOCK_FILE"; flock 9; fi

# ---------- JSON helpers ----------
db_write() { # filter [jq-args...] ; atomic write
  local filter=$1; shift
  local tmp err
  tmp=$(tmpfile ntn.db.XXXXXX) || die "mktemp failed"
  err=$(tmpfile ntn.err.XXXXXX)
  if jq "$filter" "$@" "$DB" > "$tmp" 2>"$err"; then
    mv "$tmp" "$DB"; chmod 600 "$DB"; rm -f "$err"
  else
    cat "$err" >&2; rm -f "$tmp" "$err"; die "failed to write database (jq filter)"
  fi
}

audit() {
  local now cutoff
  now=$(date +%s)
  cutoff=$((now - 105*86400))
  db_write '.audit = ([(.audit // [])[] | select(.action | test("^(config-|rollback)")) | select((.action | test("pending$")) or ((.ts | fromdateiso8601) >= $cutoff))])[-500:]' --argjson cutoff "$cutoff"
  db_write '.audit += [{ts:(now|todate), action:$a, detail:$d}]' --arg a "$1" --arg d "$2"
}
# ---------- backup archive --------------------------------------------------
safe_host() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_' ; }
month_for() {
  local s="$1"
  case "$s" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) printf '%s-%s' "${s:0:4}" "${s:4:2}" ;;
    *) date -d "$s" +%Y-%m 2>/dev/null \
         || date -j -f '%Y-%m-%d' "$s" +%Y-%m 2>/dev/null \
         || date +%Y-%m ;;
  esac
}
backup_root_for() { printf '%s/%s' "$BACKUP_DIR" "$(safe_host "$1")"; }
backup_month_for() { printf '%s/%s' "$(backup_root_for "$1")" "$(month_for "$2")"; }
month_back() {
  local y=${1%-*} m=${1#*-} n=${2:-0}
  m=$((10#$m))
  while [ "$n" -gt 0 ]; do m=$((m-1)); if [ "$m" -eq 0 ]; then m=12; y=$((y-1)); fi; n=$((n-1)); done
  printf '%04d-%02d' "$y" "$m"
}
# File legacy flat artifacts (older engine versions) into the month layout.
# Idempotent: after one pass there is nothing left to move.
migrate_backups() {
  local host=$1 safe root f base stamp month dest
  safe=$(safe_host "$host"); root="$BACKUP_DIR"
  for f in "$root/$safe"-*.cfg "$root/$safe"-*-rollback.cmd; do
    [ -f "$f" ] || continue
    base=${f##*/}; base=${base#"$safe"-}
    case "$base" in *-added.cfg|*-rollback.cmd) ;; *) continue;; esac
    stamp=${base%-added.cfg}; stamp=${stamp%-rollback.cmd}
    case "$stamp" in
      [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) month="${stamp:0:4}-${stamp:4:2}";;
      *) continue;;
    esac
    dest="$root/$safe/$month"; mkdir -p "$dest"; chmod 700 "$dest"
    mv "$f" "$dest/$base"
  done
  [ -d "$root/$safe" ] || return 0
  for f in "$root/$safe"/*-sync.cfg; do
    [ -f "$f" ] || continue
    base=${f##*/}; stamp=${base%-sync.cfg}
    case "$stamp" in
      [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) month="${stamp:0:4}-${stamp:4:2}";;
      *) continue;;
    esac
    dest="$root/$safe/$month"; mkdir -p "$dest"; chmod 700 "$dest"
    mv "$f" "$dest/$base"
  done
}

# Month folders hold at most 4 change pairs (cfg + rollback.cmd) and 4 single
# snapshots (-sync.cfg / -added.cfg); older months keep one keeper per year.
retain_backups() {
  local host=$1 root="$BACKUP_DIR/$(safe_host "$1")" dir month pair idx year current m0 m1 m2 seenyears="" sidx syear seensyears=""
  migrate_backups "$host"
  [ -d "$root" ] || return 0
  current=$(date +%Y-%m); m0=$current; m1=$(month_back "$current" 1); m2=$(month_back "$current" 2)
  while read -r dir; do
    month=${dir%/}; month=${month##*/}
    idx=0
    while read -r pair; do
      [ -n "$pair" ] || continue
      [ -s "$dir/$pair.cfg" ] && [ -s "$dir/$pair.rollback.cmd" ] || continue
      if [ "$month" = "$m0" ] || [ "$month" = "$m1" ] || [ "$month" = "$m2" ]; then
        idx=$((idx+1)); [ "$idx" -le 4 ] || rm -f "$dir/$pair.cfg" "$dir/$pair.rollback.cmd"
      else
        year=${month%%-*}
        case " $seenyears " in *" $year "*) rm -f "$dir/$pair.cfg" "$dir/$pair.rollback.cmd";; *) seenyears="$seenyears $year";; esac
      fi
    done < <(find "$dir" -maxdepth 1 -type f -name '*.cfg' ! -name '*-sync.cfg' ! -name '*-added.cfg' -exec basename {} \; 2>/dev/null | sed 's/\.cfg$//' | sort -r)
    sidx=0
    while read -r f; do
      [ -n "$f" ] || continue
      case "$f" in *-rollback.cmd) [ -s "$dir/${f%.rollback.cmd}.cfg" ] && continue;; esac
      if [ "$month" = "$m0" ] || [ "$month" = "$m1" ] || [ "$month" = "$m2" ]; then
        sidx=$((sidx+1)); [ "$sidx" -le 4 ] || rm -f "$dir/$f"
      else
        syear=${month%%-*}
        case " $seensyears " in *" $syear "*) rm -f "$dir/$f";; *) seensyears="$seensyears $syear";; esac
      fi
    done < <(find "$dir" -maxdepth 1 -type f \( -name '*-sync.cfg' -o -name '*-added.cfg' -o -name '*-rollback.cmd' \) -exec basename {} \; 2>/dev/null | sort -r)
    rmdir "$dir" 2>/dev/null || true
  done < <(find "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -r)
  rmdir "$root" 2>/dev/null || true
}
archive_pair() {
  local host=$1 stamp=$2 finalcfg=$3 rollback=$4 dir pair tmpcfg tmprb
  [ -s "$finalcfg" ] && [ -s "$rollback" ] || return 1
  dir=$(backup_month_for "$host" "$stamp"); mkdir -p "$dir"; chmod 700 "$dir"
  pair="$stamp-$$"
  tmpcfg=$(mktemp "$dir/.${pair}.cfg.XXXXXX") || die "mktemp failed"
  tmprb=$(mktemp "$dir/.${pair}.rollback.XXXXXX") || die "mktemp failed"
  TMPFILES="$TMPFILES $tmpcfg $tmprb"
  cp "$finalcfg" "$tmpcfg" && cp "$rollback" "$tmprb" || { rm -f "$tmpcfg" "$tmprb"; return 1; }
  mv "$tmpcfg" "$dir/$pair.cfg" && mv "$tmprb" "$dir/$pair.rollback.cmd" || return 1
  chmod 600 "$dir/$pair.cfg" "$dir/$pair.rollback.cmd"
  # The pair now owns the rollback. Consume the staging copy BEFORE retention
  # runs: migrate_backups would otherwise relocate it into the month folder,
  # where it survives as a duplicate and eats a sync-snapshot retention slot.
  rm -f "$rollback"
  retain_backups "$host"
  printf '%s/%s' "$dir" "$pair"
}
# the entry stays in the trail (with its original start time) but no longer
# counts as orphaned. Filter `pending` then means only attempts with no verdict
# at all — a process killed mid-apply.
audit_settle() {
  db_write '([(.audit // []) | to_entries[] | select(.value.action=="config-pending" or .value.action=="rollback-pending")] | last) as $e
            | if $e == null then . else .audit[$e.key].action = ($e.value.action | sub("pending$"; "started")) end'
}

resolve_ref() { # ref = display-number | id | ip | hostname -> print id
  jq -r --arg ref "$1" '[.devices[] | select((.id|tostring)==$ref or .ip==$ref or ((.hostname|ascii_downcase)==($ref|ascii_downcase)))] | .[0].id // empty' "$DB"
}

resolve_number() { # display row number (1-based) OR id -> print id
  jq -r --arg r "$1" '.devices | to_entries[] | select(((.key+1)|tostring)==$r or (.value.id|tostring)==$r) | .value.id' "$DB" | head -1
}

device_by_id() { jq --argjson id "$1" '.devices[] | select(.id==$id)' "$DB"; }

# ---------- brand differences ----------
# Portable case helpers. macOS ships bash 3.2, where ${x,,} / ${x^} are a
# hard "bad substitution" — that killed `ntn add` on every Mac. tr works in 3.2.
lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
ucfirst() {
  local _h _t
  _h=$(printf '%s' "$1" | cut -c1 | tr '[:lower:]' '[:upper:]')
  _t=$(printf '%s' "$1" | cut -c2-)
  printf '%s%s' "$_h" "$_t"
}
norm_brand() { case "$(lc "$1")" in cisco) echo Cisco;; huawei) echo Huawei;; aruba) echo Aruba;; arista) echo Arista;; ruijie) echo Ruijie;; juniper) echo Juniper;; fortinet|fortigate) echo Fortinet;; mikrotik) echo Mikrotik;; *) ucfirst "$1";; esac; }
norm_type()  { case "$(lc "$1")" in router) echo Router;; switch) echo Switch;; olt) echo OLT;; firewall) echo Firewall;; ap|accesspoint|access-point) echo AP;; *) ucfirst "$1";; esac; }

is_exec_brand() { case "$1" in Mikrotik) return 0;; esac; [ "$(brand_get "$1" mode)" = "exec" ]; }
is_execarg_brand() { [ "$(brand_get "$1" mode)" = "exec-arg" ]; }

run_exec_arg() { # ip port user pass command out timeout_s — one exec request, command as ssh argument
  local ip=$1 port=$2 user=$3 pass=$4 cmd=$5 out=$6 tmo=$7
  local work rc
  work=$(tmpdir ntn.ssh.XXXXXX) || die "mktemp failed"
  printf '#!/bin/bash\nprintf "%%s\\n" "$NTN_PW"\n' > "$work/askpass.sh"
  chmod 700 "$work/askpass.sh"
  NTN_PW="$pass" SSH_ASKPASS="$work/askpass.sh" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 \
    "$TIMEOUT_BIN" "$tmo" ssh -T "${SSH_OPTS[@]}" -p "$port" "$user@$ip" "$cmd" 2>&1 \
    | tr -d '\r' | grep -v '^Warning: Permanently added' > "$out"
  rc=${PIPESTATUS[0]}
  chmod 600 "$out" 2>/dev/null
  rm -rf "$work"
  return "$rc"
}

# ---- brand profiles: brands.json overrides/extends the built-in tables ----
brand_profile() { [ -f "$BRANDS_FILE" ] && jq -e --arg b "$(lc "$1")" '(.[$b] | type == "object")' "$BRANDS_FILE" >/dev/null 2>&1; }
brand_has()     { brand_profile "$1" && jq -e --arg b "$(lc "$1")" --arg k "$2" '.[$b] | has($k)' "$BRANDS_FILE" >/dev/null 2>&1; }
brand_get()     { jq -r --arg b "$(lc "$1")" --arg k "$2" '(.[$b][$k] // "")' "$BRANDS_FILE" 2>/dev/null; }

paging_cmd()   { if brand_has "$1" paging; then brand_get "$1" paging; return; fi; case "$1" in Huawei) echo "screen-length 0 temporary";; Aruba) echo "no page";; Juniper) echo "set cli screen-length 0";; Mikrotik|Fortinet) :;; *) echo "terminal length 0";; esac; }
secret_cmd()   { if brand_has "$1" secret_cmd; then brand_get "$1" secret_cmd; return; fi; case "$1" in Huawei) echo super;; Fortinet) :;; *) echo enable;; esac; }
config_enter() { if brand_has "$1" config_enter; then brand_get "$1" config_enter; return; fi; case "$1" in Juniper) echo configure;; Huawei) echo "system-view";; Mikrotik|Fortinet) :;; *) echo "configure terminal";; esac; }
config_leave() { if brand_has "$1" config_leave; then brand_get "$1" config_leave; return; fi; case "$1" in Juniper) :;; Huawei) echo return;; Mikrotik|Fortinet) :;; *) echo end;; esac; }
save_lines()   { if brand_has "$1" save_lines; then brand_get "$1" save_lines | jq -r 'if type=="array" then .[] else . end'; return; fi; case "$1" in Huawei) echo save; echo Y;; Juniper) echo commit; echo "exit configuration-mode";; Mikrotik|Fortinet) :;; *) echo "write memory";; esac; }
save_delay()   { if brand_has "$1" save_delay; then brand_get "$1" save_delay; return; fi; case "$1" in Juniper) echo 15;; *) echo 4;; esac; }

config_cmd_show() { # full config pull command
  if brand_has "$1" config_show; then brand_get "$1" config_show; return; fi
  case "$1" in
    # RouterOS normal export suppresses properties whose values are defaults.
    # Use verbose so an explicitly applied default (for example OSPF version=2)
    # remains visible to the post-check verifier.
    Mikrotik) echo "/export verbose";;
    Huawei)   echo "display current-configuration";;
    Juniper)  echo "show configuration | display set";;
    Fortinet) echo "show full-configuration";;
    *)        echo "show running-config";;
  esac
}
hostname_cmd_show() { # hostname pull command
  if brand_has "$1" hostname_show; then brand_get "$1" hostname_show; return; fi
  case "$1" in
    Mikrotik) echo "/system identity print";;
    Huawei)   echo "display current-configuration | include sysname";;
    Juniper)  echo "show configuration | display set | match host-name";;
    Fortinet) echo "get system status";;
    *)        echo "show running-config | include hostname";;
  esac
}

# per-brand error patterns (used with grep -E)
err_pattern() {
  if brand_has "$1" err_pattern; then brand_get "$1" err_pattern; return; fi
  case "$1" in
    Mikrotik) echo '^(invalid value|no such item|syntax error|expected |bad command|ambiguous|failure:|script error|\s+error:)';;
    Huawei)   echo '(^%|^\s*(Error|Unrecognized|Wrong parameter|Incomplete command))';;
    Juniper)  echo '(^%|error:|syntax error|unknown command|invalid value)';;
    Fortinet) echo '(command parse error|Unknown action|Unknown attribute|unrecognized)';;
    *)        echo '(^%|Invalid input|Incomplete command|Ambiguous|syntax error|Unknown command|^Error)';;
  esac
}

# ---------- SSH session engine: PTY mode (interactive CLI) ----------
# plan file: lines "delay<TAB>command" (empty command = just wait)
run_session() { # ip port user pass plan_file out_file timeout_s
  local ip=$1 port=$2 user=$3 pass=$4 plan=$5 out=$6 tmo=$7
  local work rc
  work=$(tmpdir ntn.ssh.XXXXXX) || die "mktemp failed"
  printf '#!/bin/bash\nprintf "%%s\\n" "$NTN_PW"\n' > "$work/askpass.sh"
  chmod 700 "$work/askpass.sh"
  (
    while IFS=$'\t' read -r delay cmd; do
      sleep "$delay"
      if [ -n "$cmd" ]; then printf '%s\n' "$cmd"; fi
    done < "$plan"
  ) | NTN_PW="$pass" SSH_ASKPASS="$work/askpass.sh" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 \
      "$TIMEOUT_BIN" "$tmo" ssh -tt "${SSH_OPTS[@]}" -p "$port" "$user@$ip" 2>&1 \
    | tr -d '\r' > "$out"
  rc=${PIPESTATUS[1]}
  chmod 600 "$out" 2>/dev/null
  rm -rf "$work"
  return "$rc"
}

# ---------- SSH session engine: EXEC mode (MikroTik RouterOS) ----------
# RouterOS runs commands from stdin at login (exec channel).
# Far more reliable than interactive mode: no banner/paging/preparation.
run_exec_mode() { # ip port user pass commands_file out_file timeout_s
  local ip=$1 port=$2 user=$3 pass=$4 cmds=$5 out=$6 tmo=$7
  local work rc
  work=$(tmpdir ntn.ssh.XXXXXX) || die "mktemp failed"
  printf '#!/bin/bash\nprintf "%%s\\n" "$NTN_PW"\n' > "$work/askpass.sh"
  chmod 700 "$work/askpass.sh"
  NTN_PW="$pass" SSH_ASKPASS="$work/askpass.sh" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 \
    "$TIMEOUT_BIN" "$tmo" ssh -T "${SSH_OPTS[@]}" -p "$port" "$user@$ip" < "$cmds" 2>&1 \
    | tr -d '\r' | grep -v '^Warning: Permanently added' > "$out"
  rc=${PIPESTATUS[0]}
  chmod 600 "$out" 2>/dev/null
  rm -rf "$work"
  return "$rc"
}

plan_timeout() { awk -F'\t' '{s+=$1} END{printf "%d", s+30}' "$1"; }

# extract one command's output from a PTY transcript: between the command echo and the next prompt
extract_cmd_output() { # command transcript
  awk -v cmd="$2" '
    BEGIN { L=length(cmd) }
    !found {
      if (length($0) >= L && substr($0, length($0)-L+1) == cmd) found=1
      next
    }
    /^(<[^<>]{1,63}>|\[[^][]+\]|[A-Za-z0-9_.@()-]{1,63}[>#]|[A-Za-z0-9_.@()-]{1,63} #) ?$/ { exit }
    { print }
  ' "$1"
}

cmd_wait() { case "$1" in *running-config*|*current-configuration*|*"show configuration"*|*full-configuration*|*"get system status"*|*"show tech"*|*"display version"*) echo 10;; *) echo 3;; esac; }

auth_failed() { grep -qE "Permission denied|Authentication failed|no matching|Connection (refused|timed out)|No route to host" "$1" 2>/dev/null; }

# The device answered the session, but the privileged level was never reached or
# the CLI rejected what we sent: the "config" is really a login/error transcript.
# Treating it as a configuration would poison config_list and any rollback
# baseline, so every pull path refuses it.
pull_bogus() { # file -> 0 when the content is NOT a real configuration
  local f=$1
  [ -s "$f" ] || return 0
  grep -qE '^% ?Bad secrets|^% ?Bad secret|^% ?Invalid input|^% ?Incomplete command|^% ?Ambiguous|^% ?Unknown command|^% ?Unknown cmd|^syntax error|^Password: *$|^Permission denied|^Authentication failed|^invalid value for argument|^Error: (Unrecognized|Invalid|Incomplete|Wrong|Ambiguous|Unknown|Syntax)|command parse error|Unknown action|Unknown attribute|^execution error|^script error' "$f" 2>/dev/null && return 0
  return 1
}

build_exec_plan() { # brand secret plan_file cmd...
  local brand=$1 secret=$2 plan=$3; shift 3
  : > "$plan"
  printf '4\t\n' >> "$plan"
  if [ -n "$secret" ] && [ -n "$(secret_cmd "$brand")" ]; then printf '2\t%s\n' "$(secret_cmd "$brand")" >> "$plan"; printf '2\t%s\n' "$secret" >> "$plan"; fi
  printf '2\t%s\n' "$(paging_cmd "$brand")" >> "$plan"
  local c
  for c in "$@"; do printf '%s\t%s\n' "$(cmd_wait "$c")" "$c" >> "$plan"; done
  printf '2\texit\n' >> "$plan"
  if [ -n "$secret" ]; then printf '2\texit\n' >> "$plan"; fi
  printf '2\t\n' >> "$plan"
}

# ---------- config / hostname pull (mode-aware) ----------
pull_config() { # ip port user pass secret brand out_file -> exit code; out contains config only
  local ip=$1 port=$2 user=$3 pass=$4 secret=$5 brand=$6 out=$7
  local rc
  if is_execarg_brand "$brand"; then
    run_exec_arg "$ip" "$port" "$user" "$pass" "$(config_cmd_show "$brand")" "$out" 120
    rc=$?
  elif is_exec_brand "$brand"; then
    local cfile; cfile=$(tmpfile ntn.cmd.XXXXXX)
    printf '%s\n' "$(config_cmd_show "$brand")" > "$cfile"
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" 90
    rc=$?
    rm -f "$cfile"
  else
    local plan transcript
    plan=$(tmpfile ntn.plan.XXXXXX)
    transcript=$(tmpfile ntn.tr.XXXXXX)
    build_exec_plan "$brand" "$secret" "$plan" "$(config_cmd_show "$brand")"
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$transcript" "$(plan_timeout "$plan")"
    rc=$?
    rm -f "$plan"
    extract_cmd_output "$transcript" "$(config_cmd_show "$brand")" > "$out"
    if auth_failed "$transcript" || [ ! -s "$out" ]; then cp "$transcript" "$out"; fi
    rm -f "$transcript"
  fi
  return $rc
}

# Used by add and sync: a pull that is really a login/error transcript must not
# be stored as a device configuration or used as a rollback baseline. Prints the
# reason on stderr and returns 1.
require_real_config() { # brand out_file label
  local brand=$1 out=$2 label=$3 pat hint=""
  if [ ! -s "$out" ]; then echo "ERROR: $label: config pull is empty." >&2; return 1; fi
  # Only PTY brands reach a privileged level; exec brands (MikroTik, Linux,
  # Windows) never log in a second time, so the secret hint does not apply.
  if is_exec_brand "$brand" || is_execarg_brand "$brand"; then
    if pull_bogus "$out"; then
      echo "ERROR: $label: the pull returned CLI errors instead of a configuration." >&2
      grep -m3 -E '^% ?Invalid input|^% ?Unknown command|^invalid value for argument|^syntax error' "$out" >&2 2>/dev/null || true
      return 1
    fi
    return 0
  fi
  if [ -z "$(secret_cmd "$brand")" ]; then return 0; fi
  # An `enable`/`super` secret that is missing or wrong kills the session at
  # "Bad secrets" and the pull is pure transcript.
  pat='^% ?Bad secrets|^% ?Bad secret|^Password: *$'
  if grep -qE "$pat" "$out" 2>/dev/null; then hint=" (stored level-2 secret was rejected — re-add the device with the correct secret)"; fi
  if pull_bogus "$out" || [ -n "$hint" ]; then
    echo "ERROR: $label: the device never reached privileged mode / returned CLI errors instead of a configuration${hint}." >&2
    grep -m3 -E "$pat|^% ?Invalid input|^% ?Unknown command|^invalid value for argument" "$out" >&2 2>/dev/null || true
    return 1
  fi
  return 0
}

pull_hostname() { # ip port user pass secret brand -> stdout hostname ('' on failure)
  local ip=$1 port=$2 user=$3 pass=$4 secret=$5 brand=$6
  local out; out=$(tmpfile ntn.hn.XXXXXX)
  local hn=""
  if is_execarg_brand "$brand"; then
    run_exec_arg "$ip" "$port" "$user" "$pass" "$(hostname_cmd_show "$brand")" "$out" 60 || true
    hn=$(awk 'NF { print; exit }' "$out" | tr -d '\r')
    rm -f "$out"
    printf '%s' "$hn"
    return 0
  fi
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(tmpfile ntn.cmd.XXXXXX)
    printf '%s\n' "$(hostname_cmd_show "$brand")" > "$cfile"
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" 60 || true
    rm -f "$cfile"
    hn=$(awk -F': *' '/^ *name:/{print $2; exit}' "$out" | tr -d '\r')
    if [ -z "$hn" ] && [ "$(brand_get "$brand" hostname_field)" = "bare" ]; then
      hn=$(awk 'NF { print; exit }' "$out" | tr -d '\r')
    fi
  else
    local plan; plan=$(tmpfile ntn.plan.XXXXXX)
    build_exec_plan "$brand" "$secret" "$plan" "$(hostname_cmd_show "$brand")"
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$out" "$(plan_timeout "$plan")" || true
    rm -f "$plan"
    local hf=""; brand_has "$brand" hostname_field && hf=$(brand_get "$brand" hostname_field)
    case "$hf" in
      sysname)   hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk 'tolower($1)=="sysname"{print $2; exit}');;
      host-name) hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk '$3=="host-name"{print $4; exit}');;
      colon)     hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk -F': *' 'tolower($1)=="hostname"{print $2; exit}');;
      hostname)  hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk 'tolower($1)=="hostname"{print $2; exit}');;
      *) case "$brand" in
        Huawei)   hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk 'tolower($1)=="sysname"{print $2; exit}');;
        Juniper)  hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk '$3=="host-name"{print $4; exit}');;
        Fortinet) hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk -F': *' 'tolower($1)=="hostname"{print $2; exit}');;
        *)        hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk 'tolower($1)=="hostname"{print $2; exit}');;
      esac;;
    esac
  fi
  rm -f "$out"
  printf '%s' "$hn"
}

# ---------- commands: list / show / add / remove ----------
cmd_list() {
  local n; n=$(jq '.devices|length' "$DB")
  if [ "$n" -eq 0 ]; then echo "(no devices yet — add one with: ntn add <IP> <Port> <Username> <Password> <Type> <Brand> [Secret])"; return 0; fi
  echo "Devices ($n):"
  jq -r '.devices | to_entries[] | "\(.key+1). \(.value.hostname) — \(.value.ip):\(.value.port) — \(.value.type) — \(.value.brand)"' "$DB"
}

cmd_show() {
  [ $# -eq 1 ] || die "usage: ntn show <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  device_by_id "$id" | jq -r '
    "hostname   : " + .hostname,
    "id         : " + (.id|tostring),
    "ip:port    : " + .ip + ":" + (.port|tostring),
    "brand/type : " + .brand + " " + .type,
    "added_at   : " + (.added_at // "-"),
    "last_sync  : " + (.last_sync // "-"),
    "check_point: " + (if .check_point=="" then "(empty)" else "available" end),
    "--- stored config_list (last sync) ---",
    (.config_list // "(empty)")'
}

cmd_add() {
  [ $# -ge 6 ] || die "usage: ntn add <IP> <Port> <Username> <Password> <Type> <Brand> [Secret]"
  local ip=$1 port=$2 user=$3 pass=$4 type=$5 brand=$6 secret=${7:-}
  [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "invalid IP: $ip"
  [[ $port =~ ^[0-9]+$ ]] || die "port must be a number: $port"
  brand=$(norm_brand "$brand"); type=$(norm_type "$type")
  case "$brand" in Cisco|Huawei|Aruba|Arista|Ruijie|Juniper|Mikrotik|Fortinet) ;; *)
    brand_profile "$brand" || echo "NOTE: brand '$brand' is not built-in — generic Cisco-like defaults apply; add a profile in $BRANDS_FILE to customize." ;;
  esac
  local dup; dup=$(jq -r --arg ip "$ip" '.devices[] | select(.ip==$ip) | .id' "$DB")
  [ -z "$dup" ] || die "IP $ip already registered (id $dup). Remove it first: ntn remove <number>"

  echo "Testing SSH connection to $ip:$port (user $user, $brand $type) ..."
  local cfgfile probe rc
  cfgfile=$(tmpfile ntn.cfg.XXXXXX)
  probe=$(tmpfile ntn.probe.XXXXXX)
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$probe"
  rc=$?
  if [ $rc -ne 0 ] || auth_failed "$probe"; then
    grep -E "Permission denied|no matching|refused|timed out|No route" "$probe" | head -3 >&2
    rm -f "$cfgfile" "$probe"
    die "connection/auth failed (exit $rc). Device NOT saved."
  fi
  mv "$probe" "$cfgfile"
  if [ ! -s "$cfgfile" ]; then
    rm -f "$cfgfile"
    die "device config is empty — device NOT saved."
  fi
  require_real_config "$brand" "$cfgfile" "add $ip" || { rm -f "$cfgfile"; die "device NOT saved."; }

  local hostname; hostname=$(pull_hostname "$ip" "$port" "$user" "$pass" "$secret" "$brand")
  [ -n "$hostname" ] || hostname="$ip"

  local id; id=$(jq -r '.next_id' "$DB")
  local dev
  dev=$(jq -n --argjson id "$id" --arg hostname "$hostname" --arg ip "$ip" --argjson port "$port" \
        --arg username "$user" --arg password "$pass" --arg secret "$secret" \
        --arg brand "$brand" --arg type "$type" --rawfile cfg "$cfgfile" \
        '{id:$id, hostname:$hostname, ip:$ip, port:$port, username:$username, password:$password,
          secret:$secret, brand:$brand, type:$type, config_list:$cfg, check_point:"",
          added_at:(now|todate), last_sync:(now|todate)}') || { rm -f "$cfgfile"; die "failed to create device entry"; }
  local stamp dir bk; stamp=$(date +%Y%m%d-%H%M%S)
  dir=$(backup_month_for "$hostname" "$stamp"); mkdir -p "$dir"; chmod 700 "$dir"
  bk="$dir/$stamp-added.cfg"
  cp "$cfgfile" "$bk"; chmod 600 "$bk"
  db_write '.devices += [$d] | .next_id += 1' --argjson d "$dev"
  rm -f "$cfgfile"
  retain_backups "$hostname"
  echo "OK: device added"
  echo "  id       : $id"
  echo "  hostname : $hostname"
  echo "  ip:port  : $ip:$port"
  echo "  brand    : $brand $type"
  echo "  config   : $(wc -l < "$bk") lines in config_list (copy: $bk)"
}

cmd_remove() {
  [ $# -ge 1 ] || die "usage: ntn remove <number|id>  (see list: ntn list)"
  local id; id=$(resolve_number "$1"); [ -n "$id" ] || die "no device with number/id $1"
  local hostname ip label safe
  hostname=$(device_by_id "$id" | jq -r '.hostname')
  ip=$(device_by_id "$id" | jq -r '.ip')
  label="$hostname ($ip)"
  safe=$(safe_host "$hostname")

  # A removal is a full erasure after the agent has obtained explicit chat
  # confirmation. Keep no stale history that could be mistaken for a later
  # device reusing the same hostname or IP.
  rm -rf "$BACKUP_DIR/$safe"
  rm -f "$BACKUP_DIR/$safe"-*.cfg "$BACKUP_DIR/$safe"-*-rollback.cmd

  db_write '.devices = [(.devices // [])[] | select(.id != $id)]
            | .checkpoints = [(.checkpoints // [])[] | select(.hostname != $h)]
            | .audit = [(.audit // [])[] | select((.detail | contains($h) | not) and (.detail | contains($ip) | not))]' --argjson id "$id" --arg h "$hostname" --arg ip "$ip"
  echo "OK: device and all related records removed → $label"
}

# ---------- commands: ping / exec / sync ----------
cmd_ping() {
  [ $# -ge 1 ] || die "usage: ntn ping <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  local ip; ip=$(device_by_id "$id" | jq -r '.ip')
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) ping -n 3 -w 2000 "$ip" 2>&1 | tail -2 ;;
    *)                    ping -c 3 -W 2 "$ip" 2>&1 | tail -2 ;;
  esac
}

run_device_commands() { # ip port user pass secret brand out_file timeout cmd... -> rc
  local ip=$1 port=$2 user=$3 pass=$4 secret=$5 brand=$6 out=$7 tmo=$8; shift 8
  if is_execarg_brand "$brand"; then
    local joined; joined=$(printf '%s & ' "$@"); joined="${joined% & }"
    run_exec_arg "$ip" "$port" "$user" "$pass" "$joined" "$out" "$tmo"
    return $?
  fi
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(tmpfile ntn.cmd.XXXXXX)
    printf '%s\n' "$@" > "$cfile"
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" "$tmo"
    local rc=$?
    rm -f "$cfile"
    return $rc
  else
    local plan; plan=$(tmpfile ntn.plan.XXXXXX)
    build_exec_plan "$brand" "$secret" "$plan" "$@"
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$out" "$(plan_timeout "$plan")"
    local rc=$?
    rm -f "$plan"
    return $rc
  fi
}

cmd_exec() {
  [ $# -ge 2 ] || die "usage: ntn exec <ref> <cmd> [cmd2 ...]"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  shift
  local dev ip port user pass secret brand hostname out rc
  dev=$(device_by_id "$id")
  hostname=$(jq -r '.hostname' <<<"$dev")
  ip=$(jq -r '.ip' <<<"$dev");      port=$(jq -r '.port' <<<"$dev")
  user=$(jq -r '.username' <<<"$dev"); pass=$(jq -r '.password' <<<"$dev")
  secret=$(jq -r '.secret' <<<"$dev"); brand=$(jq -r '.brand' <<<"$dev")
  out=$(tmpfile ntn.out.XXXXXX)
  run_device_commands "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$out" 120 "$@"
  rc=$?
  if [ $rc -ne 0 ] || auth_failed "$out"; then
    grep -E "Permission denied|no matching|refused|timed out|No route" "$out" | head -3 >&2
    rm -f "$out"; die "execution failed (exit $rc)"
  fi
  cat "$out"
  local lines; lines=$(wc -l < "$out")
  if [ "$lines" -gt 400 ]; then
    # Long transcripts stay readable for the agent, but never as /tmp litter:
    # they move into a bounded per-engine folder (newest 50 kept).
    local keep full
    keep="$NTN_HOME/transcripts"; mkdir -p "$keep"; chmod 700 "$keep"
    full="$keep/$(date +%Y%m%d-%H%M%S)-$(safe_host "$hostname").log"
    mv "$out" "$full"; chmod 600 "$full"
    TMPFILES="${TMPFILES// $out/}"
    prune_transcripts
    echo "... (transcript $lines lines; full output: $full)"
  else rm -f "$out"; fi
  return 0
}

prune_transcripts() {
  local d="$NTN_HOME/transcripts" f
  [ -d "$d" ] || return 0
  ls -1t "$d" 2>/dev/null | tail -n +51 | while read -r f; do rm -f "$d/$f"; done
}

sync_one() { # id
  local id=$1 dev ip port user pass secret brand hostname
  dev=$(device_by_id "$id")
  ip=$(jq -r '.ip' <<<"$dev");      port=$(jq -r '.port' <<<"$dev")
  user=$(jq -r '.username' <<<"$dev"); pass=$(jq -r '.password' <<<"$dev")
  secret=$(jq -r '.secret' <<<"$dev"); brand=$(jq -r '.brand' <<<"$dev")
  hostname=$(jq -r '.hostname' <<<"$dev")
  local cfgfile rc
  cfgfile=$(tmpfile ntn.cfg.XXXXXX)
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$cfgfile"
  rc=$?
  if [ $rc -ne 0 ] || auth_failed "$cfgfile"; then
    rm -f "$cfgfile"; echo "FAILED sync $hostname ($ip): connection/auth"; return 1
  fi
  if [ ! -s "$cfgfile" ]; then rm -f "$cfgfile"; echo "FAILED sync $hostname: empty config output"; return 1; fi
  if ! require_real_config "$brand" "$cfgfile" "sync $hostname ($ip)"; then rm -f "$cfgfile"; return 1; fi
  local stamp dir; stamp=$(date +%Y%m%d-%H%M%S)
  dir=$(backup_month_for "$hostname" "$stamp"); mkdir -p "$dir"; chmod 700 "$dir"
  cp "$cfgfile" "$dir/$stamp-sync.cfg"; chmod 600 "$dir/$stamp-sync.cfg"
  db_write '(.devices[] | select(.id==$id)).config_list = $cfg
            | (.devices[] | select(.id==$id)).last_sync = (now|todate)' \
           --argjson id "$id" --rawfile cfg "$cfgfile"
  rm -f "$cfgfile"
  retain_backups "$hostname"
  echo "OK sync $hostname ($ip)"
}

cmd_sync() {
  [ $# -ge 1 ] || die "usage: ntn sync <ref|all>"
  if [ "$1" = "all" ]; then
    local ids id ok=0 fail=0
    ids=$(jq -r '.devices[].id' "$DB")
    [ -n "$ids" ] || { echo "(no devices yet)"; return 0; }
    for id in $ids; do if sync_one "$id"; then ok=$((ok+1)); else fail=$((fail+1)); fi; done
    echo "Done: $ok succeeded, $fail failed"
    [ "$fail" -eq 0 ] || return 1
  else
    local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
    sync_one "$id"
  fi
}

# ---------- MikroTik script normalization ----------
# RouterOS exec-mode (ssh -T) does NOT keep context between lines:
#   /interface ethernet
#   set [ find ... ] comment=X
# the first line runs alone, the second becomes "set ..." without a path -> syntax error.
# Fix: merge a menu-path line (/xxx) into the next command as one line.
mt_normalize() { # in_file out_file -> print count of effective commands
  local line path="" n=0 tok is_path
  # RouterOS verbs: if one appears in the line, the line is a full command, not a path
  local verbs=" add set remove print export import enable disable find get unset move reset edit check run send ping traceroute reboot shutdown save load backup restore monitor comment export "
  : > "$2"
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue;; esac
    line=$(sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' <<<"$line")
    case "$line" in
      /*)
        is_path=1
        # contains '=' or '[' -> clearly a full command
        case "$line" in *=*|*'['*) is_path=0;; esac
        if [ "$is_path" -eq 1 ]; then
          for tok in $line; do
            case "$verbs" in *" $tok "*) is_path=0; break;; esac
          done
        fi
        if [ "$is_path" -eq 1 ]; then
          path="$line"; continue
        fi
        printf '%s\n' "$line" >> "$2"; path=""; n=$((n+1)); continue
        ;;
      *)
        if [ -n "$path" ]; then
          printf '%s %s\n' "$path" "$line" >> "$2"
        else
          printf '%s\n' "$line" >> "$2"
        fi
        n=$((n+1))
        ;;
    esac
  done < "$1"
  printf '%s' "$n"
}

# ---------- apply config ----------
apply_config() { # id script_file reason -> 0 on success
  local id=$1 script=$2 reason=$3
  [ -s "$script" ] || die "script file is empty or missing: $script"
  local dev ip port user pass secret brand hostname
  dev=$(device_by_id "$id")
  ip=$(jq -r '.ip' <<<"$dev");      port=$(jq -r '.port' <<<"$dev")
  user=$(jq -r '.username' <<<"$dev"); pass=$(jq -r '.password' <<<"$dev")
  secret=$(jq -r '.secret' <<<"$dev"); brand=$(jq -r '.brand' <<<"$dev")
  hostname=$(jq -r '.hostname' <<<"$dev")
  local ts; ts=$(date +%Y%m%d-%H%M%S)

  # 1) pre-change snapshot (mandatory; transaction-only, never a retained archive)
  local precfg; precfg=$(tmpfile ntn.pre.XXXXXX)
  TRANSACTION_PRE="$precfg"; TRANSACTION_FINAL=""
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$precfg" || true
  if [ ! -s "$precfg" ] || auth_failed "$precfg"; then
    rm -f "$precfg"; TRANSACTION_PRE=""
    die "failed to pull pre-change config (aborting for safety)"
  fi
  echo "Snapshot pre-change: $precfg"

  # 2) apply
  local out rc nlines eff_script
  out=$(tmpfile ntn.out.XXXXXX)
  # effective script: for MikroTik, normalized into full-path one-liners
  eff_script=$(tmpfile ntn.eff.XXXXXX)
  if is_exec_brand "$brand"; then
    nlines=$(mt_normalize "$script" "$eff_script")
  else
    cp "$script" "$eff_script"
    nlines=$(grep -cve '^\s*$' -e '^!' "$script")
  fi
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(tmpfile ntn.cmd.XXXXXX)
    cp "$eff_script" "$cfile"
    echo "Applying $nlines commands via RouterOS exec-mode ..."
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" 120
    rc=$?
    rm -f "$cfile"
  else
    local plan; plan=$(tmpfile ntn.plan.XXXXXX)
    local s skip_save=""
    case "$brand" in Cisco|Huawei|Aruba|Arista|Ruijie|Juniper|Mikrotik|Fortinet) ;; *)
      brand_profile "$brand" || { skip_save=1; echo "NOTE: unknown brand '$brand' — no save command sent (running-config only). Add save_lines in $BRANDS_FILE if the device needs one."; } ;;
    esac
    {
      printf '4\t\n'
      if [ -n "$secret" ] && [ -n "$(secret_cmd "$brand")" ]; then printf '2\t%s\n' "$(secret_cmd "$brand")"; printf '2\t%s\n' "$secret"; fi
      printf '2\t%s\n' "$(paging_cmd "$brand")"
      printf '2\t%s\n' "$(config_enter "$brand")"
      while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        case "$line" in ''|'!'*) continue;; esac
        printf '1\t%s\n' "$line"
      done < "$script"
      printf '2\t%s\n' "$(config_leave "$brand")"
      if [ -z "$skip_save" ]; then while IFS= read -r s; do [ -n "$s" ] && printf '%s\t%s\n' "$(save_delay "$brand")" "$s"; done < <(save_lines "$brand"); fi
      printf '3\texit\n'
      if [ -n "$secret" ]; then printf '2\texit\n'; fi
      printf '2\t\n'
    } > "$plan"
    echo "Applying script ($(grep -cve '^\s*$' -e '^!' "$script") effective lines) via interactive CLI ..."
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$out" "$(plan_timeout "$plan")"
    rc=$?
    rm -f "$plan"
  fi

  if auth_failed "$out"; then
    rm -f "$out"; audit "config-failed" "$hostname ($ip): session dropped / auth failed"; PENDING_AUDIT=""; audit_settle
    die "session dropped or auth failed during apply. Check the device manually; pre-change config saved at $precfg"
  fi
  # exit != 0 in RouterOS exec-mode means a command was rejected (syntax/invalid value),
  # not a dropped session — fall through to error detection below so the message is accurate.
  if [ $rc -ne 0 ] && ! is_exec_brand "$brand"; then
    rm -f "$out"; audit "config-failed" "$hostname ($ip): session dropped during apply (exit $rc)"; PENDING_AUDIT=""; audit_settle
    die "session dropped during apply (exit $rc). Check the device manually; pre-change config saved at $precfg"
  fi
  local errors
  errors=$(grep -E "$(err_pattern "$brand")" "$out" | head -10)
  if [ -z "$errors" ] && [ $rc -ne 0 ] && is_exec_brand "$brand"; then
    # RouterOS sometimes prints a single error line without a known prefix
    errors=$(grep -vE '^\s*$' "$out" | head -5)
  fi

  # 3) refresh the stored snapshot when possible. Do NOT compare script text
  # against vendor exports: renderers suppress defaults, reorder fields and
  # fold lines, which makes that a false-failure source. Functional validation
  # belongs to the agent's planned, read-only show/print commands.
  local newcfg; newcfg=$(tmpfile ntn.post.XXXXXX)
  TRANSACTION_FINAL="$newcfg"
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$newcfg" || true
  rm -f "$eff_script"

  echo "--- execution result ---"
  if [ -n "$errors" ]; then
    echo "Device errors:"; echo "$errors"
    audit "config-failed" "$hostname ($ip): $reason"; PENDING_AUDIT=""; audit_settle
    rm -f "$precfg" "$newcfg"; TRANSACTION_PRE=""; TRANSACTION_FINAL=""
    echo "STATUS: FAILED — device rejected one or more commands"
    return 1
  fi

  if [ -s "$newcfg" ]; then
    db_write '(.devices[] | select(.id==$id)).config_list = $cfg
              | (.devices[] | select(.id==$id)).last_sync = (now|todate)' \
             --argjson id "$id" --rawfile cfg "$newcfg"
    echo "Snapshot refreshed for inventory/archive"
  else
    echo "WARNING: configuration applied, but post-apply snapshot was unavailable"
  fi
  echo "STATUS: APPLIED — verify the planned read-only checks before declaring success"
  return 0
}

cmd_config() {
  local ref="" script="" rollback="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --script) script=$2; shift 2;;
      --rollback) rollback=$2; shift 2;;
      --reason) reason=$2; shift 2;;
      *) [ -z "$ref" ] && ref=$1 || die "unknown argument: $1"; shift;;
    esac
  done
  [ -n "$ref" ] && [ -n "$script" ] || die "usage: ntn config <ref> --script <file> [--rollback <file>] [--reason <text>]"
  [ -n "$reason" ] || reason="(no reason given)"
  local id; id=$(resolve_ref "$ref"); [ -n "$id" ] || die "device not found: $ref"
  local hostname ip; hostname=$(device_by_id "$id" | jq -r '.hostname'); ip=$(device_by_id "$id" | jq -r '.ip')
  local cfgbrand; cfgbrand=$(device_by_id "$id" | jq -r '.brand')
  if [ "$(brand_get "$cfgbrand" config_supported)" = "false" ]; then
    die "brand $cfgbrand has no config model — read-only exec and sync only; nothing to apply, nothing to roll back"
  fi
  local ts; ts=$(date +%Y%m%d-%H%M%S)
  local rbfile="$BACKUP_DIR/${hostname}-${ts}-rollback.cmd"

  if [ -n "$rollback" ]; then
    [ -s "$rollback" ] || die "rollback file missing/empty: $rollback"
    cp "$rollback" "$rbfile"
  else
    : > "$rbfile"
  fi

  PENDING_AUDIT="$hostname ($ip): $reason — script: $script ($(grep -cve '^\s*$' -e '^!' "$script" 2>/dev/null || echo 0) lines)"
  audit "config-pending" "$PENDING_AUDIT"

  if apply_config "$id" "$script" "$reason"; then
    if [ -n "$rollback" ]; then
      local archive
      if [ -s "$TRANSACTION_FINAL" ]; then
        archive=$(archive_pair "$hostname" "$ts" "$TRANSACTION_FINAL" "$rbfile") || {
          # The change already reached the device. Preserve its rollback and
          # report archive trouble; never relabel a successful apply as failed.
          archive=""
          echo "WARNING: applied, but paired backup archive could not be published"
        }
      else
        archive=""
        echo "WARNING: applied, but no post-apply snapshot is available for an archive"
      fi
      if [ -n "$archive" ]; then
        rbfile="$archive.rollback.cmd"
        db_write '(.devices[] | select(.id==$id)).check_point = $rb' --argjson id "$id" --rawfile rb "$rbfile"
        echo "Backup archive: $archive.cfg + $archive.rollback.cmd"
      else
        # Fallback: keep the rollback beside the change archives, not loose.
        local fdir fb
        fdir=$(backup_month_for "$hostname" "$ts"); mkdir -p "$fdir"; chmod 700 "$fdir"
        fb="$fdir/$(basename "$rbfile")"; mv "$rbfile" "$fb"; chmod 600 "$fb"; rbfile="$fb"
        db_write '(.devices[] | select(.id==$id)).check_point = $rb' --argjson id "$id" --rawfile rb "$rbfile"
        echo "Rollback retained: $rbfile"
      fi
      audit "config-ok" "$hostname ($ip): $reason"; PENDING_AUDIT=""; audit_settle
    else
      audit "config-ok" "$hostname ($ip): $reason (no rollback archive)"; PENDING_AUDIT=""; audit_settle
      echo "WARNING: no rollback script was provided"
    fi
    rm -f "$TRANSACTION_PRE" "$TRANSACTION_FINAL"; TRANSACTION_PRE=""; TRANSACTION_FINAL=""
    db_write '.checkpoints = (((.checkpoints // []) + [{ts:(now|todate), hostname:$h, reason:$r, rollback_file:$f}]))[-200:]' \
             --arg h "$hostname" --arg r "$reason" --arg f "$rbfile"
  else
    rm -f "$TRANSACTION_PRE" "$TRANSACTION_FINAL" "$rbfile"; TRANSACTION_PRE=""; TRANSACTION_FINAL=""
    die "apply failed — fix the script and retry"
  fi
}

cmd_rollback() {
  [ $# -ge 1 ] || die "usage: ntn rollback <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  local rb hostname
  rb=$(device_by_id "$id" | jq -r '.check_point')
  hostname=$(device_by_id "$id" | jq -r '.hostname')
  [ -n "$rb" ] || die "check_point empty for $hostname — nothing to roll back"
  local rbtmp; rbtmp=$(tmpfile ntn.rb.XXXXXX)
  printf '%s\n' "$rb" > "$rbtmp"
  echo "Running rollback for $hostname ..."
  PENDING_AUDIT="$hostname (rollback): restoring check_point script ($(grep -cve '^\s*$' "$rbtmp" 2>/dev/null || echo 0) lines)"
  audit "rollback-pending" "$PENDING_AUDIT"
  if apply_config "$id" "$rbtmp" "ROLLBACK"; then
    db_write '(.devices[] | select(.id==$id)).check_point = ""' --argjson id "$id"
    audit "rollback" "$hostname"; PENDING_AUDIT=""; audit_settle
    echo "STATUS: ROLLBACK SUCCESS — check_point cleared"
  else
    rm -f "$rbtmp"
    audit "rollback-failed" "$hostname: rollback apply failed — check manually; snapshots are in $BACKUP_DIR"
    PENDING_AUDIT=""; audit_settle
    die "rollback failed — check manually; snapshots are in $BACKUP_DIR"
  fi
  rm -f "$rbtmp"
}

cmd_checkpoints() {
  [ $# -ge 1 ] || die "usage: ntn checkpoints <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device not found: $1"
  local hostname; hostname=$(device_by_id "$id" | jq -r '.hostname')
  local n; n=$(jq --arg h "$hostname" '[(.checkpoints // [])[] | select(.hostname==$h)] | length' "$DB")
  echo "Checkpoint history for $hostname ($n entries, newest last):"
  jq -r --arg h "$hostname" '[(.checkpoints // [])[] | select(.hostname==$h)][-10:][] | "  \(.ts) — \(.reason)\n    rollback file: \(.rollback_file)"' "$DB"
}

cmd_audit() { # ntn audit [N | pending|failed|config|all] [N]   (internal)
  local filter="" n=20
  case "${1:-}" in
    "") ;;
    *[!0-9]*) filter=$1; [ -n "${2:-}" ] && n=$2 ;;
    *) n=$1 ;;
  esac
  local row='.[-$n:][] | "\(.ts)  \(.action)  \(.detail)"'
  case "$filter" in
    "")      jq -r --argjson n "$n" "[(.audit // [])[]] | $row" "$DB";;
    pending) jq -r --argjson n "$n" --arg re '^(config-pending|rollback-pending)$' "[(.audit // [])[] | select(.action | test(\$re))] | $row" "$DB";;
    failed)  jq -r --argjson n "$n" --arg re 'failed$' "[(.audit // [])[] | select(.action | test(\$re))] | $row" "$DB";;
    config)  jq -r --argjson n "$n" --arg re '^(config-|rollback)' "[(.audit // [])[] | select(.action | test(\$re))] | $row" "$DB";;
    all)     jq -r --argjson n "$n" "[(.audit // [])[]] | $row" "$DB";;
    *) die "unknown audit filter: $filter (use a number, or: pending | failed | config | all)" ;;
  esac
}

usage() {
  cat <<'EOF'
ntn — NTnRoute.AI device engine
  ntn list                                   list devices (hostname, ip:port, type, brand)
  ntn add <IP> <Port> <User> <Pass> <Type> <Brand> [Secret]
                                             test connection, pull hostname and config, then save
  ntn remove <number|id>                     remove a device from the inventory
  ntn show <ref>                             show device details and stored config
  ntn sync <ref|all>                         pull the latest running configuration
EOF
}

main() {
  local sub=${1:-help}; shift || true
  # Skill-owned operations must be indistinguishable from a typo: same usage
  # block, same "unknown command" error, same exit code.
  case " exec ping config rollback checkpoints audit " in
    *" $sub "*)
      [ "${NTN_INTERNAL:-}" = "1" ] || { usage; die "unknown command: $sub"; };;
  esac
  case "$sub" in
    list) cmd_list;;
    add) cmd_add "$@";;
    show) cmd_show "$@";;
    remove) cmd_remove "$@";;
    ping) cmd_ping "$@";;
    exec) cmd_exec "$@";;
    sync) cmd_sync "$@";;
    config) cmd_config "$@";;
    rollback) cmd_rollback "$@";;
    checkpoints) cmd_checkpoints "$@";;
    audit) cmd_audit "$@";;
    help|--help|-h) usage;;
    *) usage; die "unknown command: $sub";;
  esac
}

main "$@"
