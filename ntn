#!/usr/bin/env bash
# ============================================================
# ntn — engine NTnRoute.AI untuk Hermes Agent
# Inventaris device jaringan persisten (~/.ntnroute/devices.json)
# + eksekusi SSH via OpenSSH (flag legacy crypto otomatis).
# Dua mode sesi:
#   PTY  (ssh -tt + plan berjeda) -> Cisco/Huawei/Aruba/Ruijie/Arista/Juniper
#   EXEC (ssh -T, stdin pipe)     -> Mikrotik RouterOS
# Semua output teks biasa. Error diawali "ERROR:" dan exit 1.
# ============================================================
set -o pipefail

NTN_HOME="${NTN_HOME:-$HOME/.ntnroute}"
DB="$NTN_HOME/devices.json"
BACKUP_DIR="$NTN_HOME/backups"
LOCK_FILE="$NTN_HOME/.lock"
TMPBASE="${TMPDIR:-/tmp}"

SSH_OPTS=(
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1,diffie-hellman-group-exchange-sha1
  -o HostKeyAlgorithms=+ssh-rsa
  -o PubkeyAcceptedAlgorithms=+ssh-rsa
  -o Ciphers=+aes128-cbc,3des-cbc
  -o MACs=+hmac-sha1
  -o PreferredAuthentications=password
  -o NumberOfPasswordPrompts=1
)

die() { echo "ERROR: $*" >&2; exit 1; }
umask 077
command -v jq  >/dev/null 2>&1 || die "jq tidak ditemukan"
command -v ssh >/dev/null 2>&1 || die "ssh tidak ditemukan"

mkdir -p "$BACKUP_DIR"
[ -f "$DB" ] || { echo '{"devices":[],"checkpoints":[],"audit":[],"next_id":1}' > "$DB"; chmod 600 "$DB"; }
if command -v flock >/dev/null 2>&1; then exec 9>"$LOCK_FILE"; flock 9; fi

# ---------- helper JSON ----------
db_write() { # filter [jq-args...] ; tulis atomik
  local filter=$1; shift
  local tmp err
  tmp=$(mktemp "$TMPBASE/ntn.db.XXXXXX") || die "mktemp gagal"
  err=$(mktemp "$TMPBASE/ntn.err.XXXXXX")
  if jq "$filter" "$@" "$DB" > "$tmp" 2>"$err"; then
    mv "$tmp" "$DB"; chmod 600 "$DB"; rm -f "$err"
  else
    cat "$err" >&2; rm -f "$tmp" "$err"; die "gagal menulis database (filter jq)"
  fi
}

audit() { db_write '.audit = (.audit + [{ts:(now|todate), action:$a, detail:$d}])[-500:]' --arg a "$1" --arg d "$2"; }

resolve_ref() { # ref = nomor-tampil | id | ip | hostname -> cetak id
  jq -r --arg ref "$1" '[.devices[] | select((.id|tostring)==$ref or .ip==$ref or ((.hostname|ascii_downcase)==($ref|ascii_downcase)))] | .[0].id // empty' "$DB"
}

resolve_number() { # nomor urut tampilan (1-based) ATAU id -> cetak id
  jq -r --arg r "$1" '.devices | to_entries[] | select(((.key+1)|tostring)==$r or (.value.id|tostring)==$r) | .value.id' "$DB" | head -1
}

device_by_id() { jq --argjson id "$1" '.devices[] | select(.id==$id)' "$DB"; }

# ---------- perbedaan brand ----------
norm_brand() { case "${1,,}" in cisco) echo Cisco;; huawei) echo Huawei;; aruba) echo Aruba;; arista) echo Arista;; ruijie) echo Ruijie;; juniper) echo Juniper;; mikrotik) echo Mikrotik;; *) echo "${1^}";; esac; }
norm_type()  { case "${1,,}" in router) echo Router;; switch) echo Switch;; olt) echo OLT;; firewall) echo Firewall;; ap|accesspoint|access-point) echo AP;; *) echo "${1^}";; esac; }

is_exec_brand() { [ "$1" = "Mikrotik" ]; }

paging_cmd()   { case "$1" in Huawei) echo "screen-length 0 temporary";; Aruba) echo "no page";; Juniper) echo "set cli screen-length 0";; Mikrotik) :;; *) echo "terminal length 0";; esac; }
secret_cmd()   { case "$1" in Huawei) echo super;; *) echo enable;; esac; }
config_enter() { case "$1" in Juniper) echo configure;; Mikrotik) :;; *) echo "configure terminal";; esac; }
config_leave() { case "$1" in Juniper) echo "exit configuration";; Mikrotik) :;; *) echo end;; esac; }
save_lines()   { case "$1" in Huawei) echo save; echo Y;; Juniper) echo commit;; Mikrotik) :;; *) echo "write memory";; esac; }

config_cmd_show() { # perintah ambil config penuh
  case "$1" in
    Mikrotik) echo "/export";;
    Huawei)   echo "display current-configuration";;
    *)        echo "show running-config";;
  esac
}
hostname_cmd_show() { # perintah ambil hostname
  case "$1" in
    Mikrotik) echo "/system identity print";;
    *)        echo "show running-config | include hostname";;
  esac
}

# pola error per brand (dipakai grep -E)
err_pattern() {
  case "$1" in
    Mikrotik) echo '^(invalid value|no such item|syntax error|expected |bad command|ambiguous|failure:|script error|\s+error:)';;
    Huawei)   echo '(^%|^\s*(Error|Unrecognized|Wrong parameter|Incomplete command))';;
    *)        echo '(^%|Invalid input|Incomplete command|Ambiguous|syntax error|Unknown command|^Error)';;
  esac
}

# ---------- mesin sesi SSH: mode PTY (interactive CLI) ----------
# plan file: baris "delay<TAB>perintah" (perintah boleh kosong = hanya tunggu)
run_session() { # ip port user pass plan_file out_file timeout_s
  local ip=$1 port=$2 user=$3 pass=$4 plan=$5 out=$6 tmo=$7
  local work rc
  work=$(mktemp -d "$TMPBASE/ntn.ssh.XXXXXX") || die "mktemp gagal"
  printf '#!/bin/bash\nprintf "%%s\\n" "$NTN_PW"\n' > "$work/askpass.sh"
  chmod 700 "$work/askpass.sh"
  (
    while IFS=$'\t' read -r delay cmd; do
      sleep "$delay"
      if [ -n "$cmd" ]; then printf '%s\n' "$cmd"; fi
    done < "$plan"
  ) | NTN_PW="$pass" SSH_ASKPASS="$work/askpass.sh" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 \
      timeout "$tmo" ssh -tt "${SSH_OPTS[@]}" -p "$port" "$user@$ip" 2>&1 \
    | tr -d '\r' > "$out"
  rc=${PIPESTATUS[1]}
  chmod 600 "$out" 2>/dev/null
  rm -rf "$work"
  return "$rc"
}

# ---------- mesin sesi SSH: mode EXEC (Mikrotik RouterOS) ----------
# RouterOS menjalankan perintah dari stdin pada saat login (exec channel).
# Jauh lebih andal daripada mode interaktif: tidak ada banner/paging/prepare.
run_exec_mode() { # ip port user pass commands_file out_file timeout_s
  local ip=$1 port=$2 user=$3 pass=$4 cmds=$5 out=$6 tmo=$7
  local work rc
  work=$(mktemp -d "$TMPBASE/ntn.ssh.XXXXXX") || die "mktemp gagal"
  printf '#!/bin/bash\nprintf "%%s\\n" "$NTN_PW"\n' > "$work/askpass.sh"
  chmod 700 "$work/askpass.sh"
  NTN_PW="$pass" SSH_ASKPASS="$work/askpass.sh" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 \
    timeout "$tmo" ssh -T "${SSH_OPTS[@]}" -p "$port" "$user@$ip" < "$cmds" 2>&1 \
    | tr -d '\r' | grep -v '^Warning: Permanently added' > "$out"
  rc=${PIPESTATUS[0]}
  chmod 600 "$out" 2>/dev/null
  rm -rf "$work"
  return "$rc"
}

plan_timeout() { awk -F'\t' '{s+=$1} END{printf "%d", s+30}' "$1"; }

# ambil output satu perintah dari transkrip PTY: antara baris echo perintah dan prompt berikutnya
extract_cmd_output() { # transkrip perintah
  awk -v cmd="$2" '
    BEGIN { L=length(cmd) }
    !found {
      if (length($0) >= L && substr($0, length($0)-L+1) == cmd) found=1
      next
    }
    /^[A-Za-z0-9_.()-]+[>#] ?$/ { exit }
    { print }
  ' "$1"
}

cmd_wait() { case "$1" in *running-config*|*current-configuration*|*"show tech"*|*"display version"*) echo 10;; *) echo 3;; esac; }

auth_failed() { grep -qE "Permission denied|Authentication failed|no matching|Connection (refused|timed out)|No route to host" "$1" 2>/dev/null; }

build_exec_plan() { # brand secret plan_file cmd...
  local brand=$1 secret=$2 plan=$3; shift 3
  : > "$plan"
  printf '4\t\n' >> "$plan"
  if [ -n "$secret" ]; then printf '2\t%s\n' "$(secret_cmd "$brand")" >> "$plan"; printf '2\t%s\n' "$secret" >> "$plan"; fi
  printf '2\t%s\n' "$(paging_cmd "$brand")" >> "$plan"
  local c
  for c in "$@"; do printf '%s\t%s\n' "$(cmd_wait "$c")" "$c" >> "$plan"; done
  printf '2\texit\n' >> "$plan"
  if [ -n "$secret" ]; then printf '2\texit\n' >> "$plan"; fi
  printf '2\t\n' >> "$plan"
}

# ---------- ambil config / hostname (sadar-mode) ----------
pull_config() { # ip port user pass secret brand out_file -> exit code; out berisi config saja
  local ip=$1 port=$2 user=$3 pass=$4 secret=$5 brand=$6 out=$7
  local rc
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(mktemp "$TMPBASE/ntn.cmd.XXXXXX")
    printf '%s\n' "$(config_cmd_show "$brand")" > "$cfile"
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" 90
    rc=$?
    rm -f "$cfile"
  else
    local plan transcript
    plan=$(mktemp "$TMPBASE/ntn.plan.XXXXXX")
    transcript=$(mktemp "$TMPBASE/ntn.tr.XXXXXX")
    build_exec_plan "$brand" "$secret" "$plan" "$(config_cmd_show "$brand")"
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$transcript" "$(plan_timeout "$plan")"
    rc=$?
    rm -f "$plan"
    extract_cmd_output "$transcript" "$(config_cmd_show "$brand")" > "$out"
    if auth_failed "$transcript" || [ ! -s "$out" ]; then cp "$transcript" "$out"; fi
    rm -f "$transcript"
  fi
  return $rc
}

pull_hostname() { # ip port user pass secret brand -> stdout hostname ('' bila gagal)
  local ip=$1 port=$2 user=$3 pass=$4 secret=$5 brand=$6
  local out; out=$(mktemp "$TMPBASE/ntn.hn.XXXXXX")
  local hn=""
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(mktemp "$TMPBASE/ntn.cmd.XXXXXX")
    printf '%s\n' "$(hostname_cmd_show "$brand")" > "$cfile"
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" 60 || true
    rm -f "$cfile"
    hn=$(awk -F': *' '/^ *name:/{print $2; exit}' "$out" | tr -d '\r')
  else
    local plan; plan=$(mktemp "$TMPBASE/ntn.plan.XXXXXX")
    build_exec_plan "$brand" "$secret" "$plan" "$(hostname_cmd_show "$brand")"
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$out" "$(plan_timeout "$plan")" || true
    rm -f "$plan"
    hn=$(extract_cmd_output "$out" "$(hostname_cmd_show "$brand")" | awk 'tolower($1)=="hostname"{print $2; exit}')
  fi
  rm -f "$out"
  printf '%s' "$hn"
}

# ---------- perintah: list / show / add / remove ----------
cmd_list() {
  local n; n=$(jq '.devices|length' "$DB")
  if [ "$n" -eq 0 ]; then echo "(belum ada device — tambah dengan: ntn add <IP> <Port> <Username> <Password> <Type> <Brand> [Secret])"; return 0; fi
  echo "Daftar device ($n):"
  jq -r '.devices | to_entries[] | "\(.key+1). [id \(.value.id)] \(.value.hostname) — \(.value.ip):\(.value.port) (\(.value.brand) \(.value.type)) | sync terakhir: \(.value.last_sync // "-")"' "$DB"
}

cmd_show() {
  [ $# -ge 1 ] || die "usage: ntn show <ref> [--reveal]"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device tidak ditemukan: $1"
  local reveal=0; [ "${2:-}" = "--reveal" ] && reveal=1
  device_by_id "$id" | jq -r --argjson reveal "$reveal" '
    "hostname   : " + .hostname,
    "id         : " + (.id|tostring),
    "ip:port    : " + .ip + ":" + (.port|tostring),
    "brand/type : " + .brand + " " + .type,
    "username   : " + .username,
    "password   : " + (if $reveal==1 then .password else "****" end),
    "secret     : " + (if .secret=="" then "(none)" elif $reveal==1 then .secret else "****" end),
    "added_at   : " + (.added_at // "-"),
    "last_sync  : " + (.last_sync // "-"),
    "check_point: " + (if .check_point=="" then "(kosong)" else ((.check_point|split("\n")|length)|tostring) + " baris" end),
    "--- config_list ---",
    (.config_list // "(kosong)")'
}

cmd_add() {
  [ $# -ge 6 ] || die "format: ntn add <IP> <Port> <Username> <Password> <Type> <Brand> [Secret]"
  local ip=$1 port=$2 user=$3 pass=$4 type=$5 brand=$6 secret=${7:-}
  [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "IP tidak valid: $ip"
  [[ $port =~ ^[0-9]+$ ]] || die "port harus angka: $port"
  brand=$(norm_brand "$brand"); type=$(norm_type "$type")
  local dup; dup=$(jq -r --arg ip "$ip" '.devices[] | select(.ip==$ip) | .id' "$DB")
  [ -z "$dup" ] || die "IP $ip sudah terdaftar (id $dup). Hapus dulu: ntn remove <nomor>"

  echo "Menguji koneksi SSH ke $ip:$port (user $user, $brand $type) ..."
  local cfgfile probe rc
  cfgfile=$(mktemp "$TMPBASE/ntn.cfg.XXXXXX")
  probe=$(mktemp "$TMPBASE/ntn.probe.XXXXXX")
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$probe"
  rc=$?
  if [ $rc -ne 0 ] || auth_failed "$probe"; then
    grep -E "Permission denied|no matching|refused|timed out|No route" "$probe" | head -3 >&2
    rm -f "$cfgfile" "$probe"; audit "add-failed" "$ip (auth/koneksi gagal)"
    die "koneksi/auth gagal (exit $rc). Device TIDAK disimpan."
  fi
  mv "$probe" "$cfgfile"
  if [ ! -s "$cfgfile" ]; then
    rm -f "$cfgfile"
    audit "add-failed" "$ip (config kosong)"
    die "config device kosong — device TIDAK disimpan."
  fi

  local hostname; hostname=$(pull_hostname "$ip" "$port" "$user" "$pass" "$secret" "$brand")
  [ -n "$hostname" ] || hostname="$ip"

  local id; id=$(jq -r '.next_id' "$DB")
  local dev
  dev=$(jq -n --argjson id "$id" --arg hostname "$hostname" --arg ip "$ip" --argjson port "$port" \
        --arg username "$user" --arg password "$pass" --arg secret "$secret" \
        --arg brand "$brand" --arg type "$type" --rawfile cfg "$cfgfile" \
        '{id:$id, hostname:$hostname, ip:$ip, port:$port, username:$username, password:$password,
          secret:$secret, brand:$brand, type:$type, config_list:$cfg, check_point:"",
          added_at:(now|todate), last_sync:(now|todate)}') || { rm -f "$cfgfile"; die "gagal membuat entri device"; }
  local bk; bk="$BACKUP_DIR/${hostname}-$(date +%Y%m%d-%H%M%S)-added.cfg"
  cp "$cfgfile" "$bk"
  db_write '.devices += [$d] | .next_id += 1' --argjson d "$dev"
  rm -f "$cfgfile"
  audit "add" "$hostname ($ip) $brand $type"
  echo "OK: device ditambahkan"
  echo "  id       : $id"
  echo "  hostname : $hostname"
  echo "  ip:port  : $ip:$port"
  echo "  brand    : $brand $type"
  echo "  config   : $(wc -l < "$bk") baris di config_list (salinan: $bk)"
}

cmd_remove() {
  [ $# -ge 1 ] || die "usage: ntn remove <nomor-urut|id>  (lihat daftar: ntn list)"
  local id; id=$(resolve_number "$1"); [ -n "$id" ] || die "tidak ada device nomor/id $1"
  local label; label=$(device_by_id "$id" | jq -r '.hostname + " (" + .ip + ")"')
  db_write '.devices = [.devices[] | select(.id != $id)]' --argjson id "$id"
  audit "remove" "$label"
  echo "OK: device dihapus → $label"
}

# ---------- perintah: ping / exec / sync ----------
cmd_ping() {
  [ $# -ge 1 ] || die "usage: ntn ping <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device tidak ditemukan: $1"
  local ip; ip=$(device_by_id "$id" | jq -r '.ip')
  ping -c 3 -W 2 "$ip" 2>&1 | tail -2
}

run_device_commands() { # ip port user pass secret brand out_file timeout cmd... -> rc
  local ip=$1 port=$2 user=$3 pass=$4 secret=$5 brand=$6 out=$7 tmo=$8; shift 8
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(mktemp "$TMPBASE/ntn.cmd.XXXXXX")
    printf '%s\n' "$@" > "$cfile"
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" "$tmo"
    local rc=$?
    rm -f "$cfile"
    return $rc
  else
    local plan; plan=$(mktemp "$TMPBASE/ntn.plan.XXXXXX")
    build_exec_plan "$brand" "$secret" "$plan" "$@"
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$out" "$(plan_timeout "$plan")"
    local rc=$?
    rm -f "$plan"
    return $rc
  fi
}

cmd_exec() {
  [ $# -ge 2 ] || die "usage: ntn exec <ref> <perintah> [perintah2 ...]"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device tidak ditemukan: $1"
  shift
  local dev ip port user pass secret brand out rc
  dev=$(device_by_id "$id")
  ip=$(jq -r '.ip' <<<"$dev");      port=$(jq -r '.port' <<<"$dev")
  user=$(jq -r '.username' <<<"$dev"); pass=$(jq -r '.password' <<<"$dev")
  secret=$(jq -r '.secret' <<<"$dev"); brand=$(jq -r '.brand' <<<"$dev")
  out=$(mktemp "$TMPBASE/ntn.out.XXXXXX")
  run_device_commands "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$out" 120 "$@"
  rc=$?
  if [ $rc -ne 0 ] || auth_failed "$out"; then
    grep -E "Permission denied|no matching|refused|timed out|No route" "$out" | head -3 >&2
    rm -f "$out"; die "eksekusi gagal (exit $rc)"
  fi
  cat "$out"
  local lines; lines=$(wc -l < "$out")
  if [ "$lines" -gt 400 ]; then echo "... (transkrip $lines baris; output penuh: $out)"; else rm -f "$out"; fi
  return 0
}

sync_one() { # id
  local id=$1 dev ip port user pass secret brand hostname
  dev=$(device_by_id "$id")
  ip=$(jq -r '.ip' <<<"$dev");      port=$(jq -r '.port' <<<"$dev")
  user=$(jq -r '.username' <<<"$dev"); pass=$(jq -r '.password' <<<"$dev")
  secret=$(jq -r '.secret' <<<"$dev"); brand=$(jq -r '.brand' <<<"$dev")
  hostname=$(jq -r '.hostname' <<<"$dev")
  local cfgfile rc
  cfgfile=$(mktemp "$TMPBASE/ntn.cfg.XXXXXX")
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$cfgfile"
  rc=$?
  if [ $rc -ne 0 ] || auth_failed "$cfgfile"; then
    rm -f "$cfgfile"; echo "GAGAL sync $hostname ($ip): koneksi/auth"; audit "sync-failed" "$hostname ($ip)"; return 1
  fi
  if [ ! -s "$cfgfile" ]; then rm -f "$cfgfile"; echo "GAGAL sync $hostname: output config kosong"; audit "sync-failed" "$hostname ($ip)"; return 1; fi
  cp "$cfgfile" "$BACKUP_DIR/${hostname}-$(date +%Y%m%d-%H%M%S).cfg"
  db_write '(.devices[] | select(.id==$id)).config_list = $cfg
            | (.devices[] | select(.id==$id)).last_sync = (now|todate)' \
           --argjson id "$id" --rawfile cfg "$cfgfile"
  rm -f "$cfgfile"
  audit "sync" "$hostname ($ip)"
  echo "OK sync $hostname ($ip)"
}

cmd_sync() {
  [ $# -ge 1 ] || die "usage: ntn sync <ref|all>"
  if [ "$1" = "all" ]; then
    local ids id ok=0 fail=0
    ids=$(jq -r '.devices[].id' "$DB")
    [ -n "$ids" ] || { echo "(belum ada device)"; return 0; }
    for id in $ids; do if sync_one "$id"; then ok=$((ok+1)); else fail=$((fail+1)); fi; done
    echo "Selesai: $ok sukses, $fail gagal"
  else
    local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device tidak ditemukan: $1"
    sync_one "$id"
  fi
}

# ---------- normalisasi script Mikrotik ----------
# RouterOS exec-mode (ssh -T) TIDAK mempertahankan konteks antar baris:
#   /interface ethernet
#   set [ find ... ] comment=X
# baris pertama jalan sendiri, baris kedua jadi "set ..." tanpa path -> syntax error.
# Solusinya: gabungkan baris menu-path (/xxx) ke perintah berikutnya jadi satu baris.
mt_normalize() { # in_file out_file -> cetak jumlah perintah efektif
  local line path="" n=0 tok is_path
  # kata kerja RouterOS: kalau ada di baris, baris itu perintah lengkap, bukan path
  local verbs=" add set remove print export import enable disable find get unset move reset edit check run send ping traceroute reboot shutdown save load backup restore monitor comment export "
  : > "$2"
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue;; esac
    line=$(sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' <<<"$line")
    case "$line" in
      /*)
        is_path=1
        # ada '=' atau '[' -> jelas perintah lengkap
        case "$line" in *=*|*'['*) is_path=0;; esac
        if [ "$is_path" -eq 1 ]; then
          for tok in $line; do
            case "$verbs" in *" $tok "*) is_path=0; break;; esac
          done
        fi
        if [ "$is_path" -eq 1 ]; then
          path="$line"; continue
        fi
        printf '%s\n' "$line" >> "$2"; path=""; n=$((n+1)); continue
        ;;
      *)
        if [ -n "$path" ]; then
          printf '%s %s\n' "$path" "$line" >> "$2"
        else
          printf '%s\n' "$line" >> "$2"
        fi
        n=$((n+1))
        ;;
    esac
  done < "$1"
  printf '%s' "$n"
}

# ---------- verifikasi post-check ----------
MISSING=(); UNCHECKED=()

# Mikrotik: /export menata ulang argumen (urutan & baris lipat berubah),
# jadi cocokkan tiap token key=value terhadap export yang spasi/backslash-nya dibuang.
verify_mikrotik() { # newcfg script
  local newcfg=$1 script=$2
  # flatten: buang spasi, newline, backslash, dan tanda kutip di kedua sisi
  local flat; flat=$(tr -d ' \t\r\n\\"' < "$newcfg")
  local line word tok checked destructive
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue;; esac
    # Perintah destruktif (remove/unset/disable/reset) menghapus objeknya sendiri,
    # jadi token di dalamnya justru HARUS tidak ada di export. Verifikasi terbalik
    # tidak bisa diotomatiskan di sini -> masukkan UNCHECKED, jangan MISSING.
    destructive=0
    case " $line " in
      *" remove "*|*" unset "*|*" disable "*|*" reset "*) destructive=1;;
    esac
    if [ "$destructive" -eq 1 ]; then
      UNCHECKED+=("$line (perintah destruktif — cek manual)")
      continue
    fi
    checked=0
    for word in $line; do
      case "$word" in
        *=*)
          tok="${word//\"/}"
          checked=$((checked+1))
          # RouterOS menghilangkan nilai kosong dari /export (mis. comment=""),
          # jadi token bernilai kosong tidak bisa diverifikasi -> catat UNCHECKED saja.
          case "$tok" in
            *=) UNCHECKED+=("$line :: $tok (nilai kosong tidak muncul di export)");;
            *)  case "$flat" in *"$tok"*) ;; *) MISSING+=("$line :: token $tok");; esac;;
          esac
          ;;
      esac
    done
    [ "$checked" -eq 0 ] && UNCHECKED+=("$line")
  done < "$script"
}

# Brand lain: cocokkan baris dinormalisasi persis.
verify_exact() { # newcfg script
  local newcfg=$1 script=$2
  local normfile; normfile=$(mktemp "$TMPBASE/ntn.norm.XXXXXX")
  sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' "$newcfg" > "$normfile"
  local line n
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    n=$(sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' <<<"$line")
    case "$n" in ''|'!'*|'#'*|end|exit|'configure terminal'|configure) continue;; esac
    if [[ $n == "no "* ]]; then
      UNCHECKED+=("$n")
    else
      grep -Fxq -- "$n" "$normfile" || MISSING+=("$n")
    fi
  done < "$script"
  rm -f "$normfile"
}

# ---------- apply config ----------
apply_config() { # id script_file reason -> 0 sukses
  local id=$1 script=$2 reason=$3
  [ -s "$script" ] || die "file script kosong atau tidak ada: $script"
  local dev ip port user pass secret brand hostname
  dev=$(device_by_id "$id")
  ip=$(jq -r '.ip' <<<"$dev");      port=$(jq -r '.port' <<<"$dev")
  user=$(jq -r '.username' <<<"$dev"); pass=$(jq -r '.password' <<<"$dev")
  secret=$(jq -r '.secret' <<<"$dev"); brand=$(jq -r '.brand' <<<"$dev")
  hostname=$(jq -r '.hostname' <<<"$dev")
  local ts; ts=$(date +%Y%m%d-%H%M%S)

  # 1) snapshot pre-change (wajib; abort bila gagal)
  local precfg="$BACKUP_DIR/${hostname}-${ts}-pre.cfg"
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$precfg" || true
  if [ ! -s "$precfg" ] || auth_failed "$precfg"; then
    rm -f "$precfg"
    die "gagal mengambil config sebelum perubahan (abort demi keamanan)"
  fi
  echo "Snapshot pre-change: $precfg"

  # 2) apply
  local out rc nlines eff_script
  out=$(mktemp "$TMPBASE/ntn.out.XXXXXX")
  # script efektif: untuk Mikrotik dinormalisasi jadi path-penuh satu-baris
  eff_script=$(mktemp "$TMPBASE/ntn.eff.XXXXXX")
  if is_exec_brand "$brand"; then
    nlines=$(mt_normalize "$script" "$eff_script")
  else
    cp "$script" "$eff_script"
    nlines=$(grep -cve '^\s*$' -e '^!' "$script")
  fi
  if is_exec_brand "$brand"; then
    local cfile; cfile=$(mktemp "$TMPBASE/ntn.cmd.XXXXXX")
    cp "$eff_script" "$cfile"
    echo "Menerapkan $nlines perintah via exec-mode RouterOS ..."
    run_exec_mode "$ip" "$port" "$user" "$pass" "$cfile" "$out" 120
    rc=$?
    rm -f "$cfile"
  else
    local plan; plan=$(mktemp "$TMPBASE/ntn.plan.XXXXXX")
    {
      printf '4\t\n'
      if [ -n "$secret" ]; then printf '2\t%s\n' "$(secret_cmd "$brand")"; printf '2\t%s\n' "$secret"; fi
      printf '2\t%s\n' "$(paging_cmd "$brand")"
      printf '2\t%s\n' "$(config_enter "$brand")"
      while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        case "$line" in ''|'!'*) continue;; esac
        printf '1\t%s\n' "$line"
      done < "$script"
      printf '2\t%s\n' "$(config_leave "$brand")"
      local s
      while IFS= read -r s; do [ -n "$s" ] && printf '4\t%s\n' "$s"; done < <(save_lines "$brand")
      printf '3\texit\n'
      if [ -n "$secret" ]; then printf '2\texit\n'; fi
      printf '2\t\n'
    } > "$plan"
    echo "Menerapkan script ($(grep -cve '^\s*$' -e '^!' "$script") baris efektif) via CLI interaktif ..."
    run_session "$ip" "$port" "$user" "$pass" "$plan" "$out" "$(plan_timeout "$plan")"
    rc=$?
    rm -f "$plan"
  fi

  if auth_failed "$out"; then
    rm -f "$out"; audit "config-failed" "$hostname ($ip): sesi putus / auth gagal"
    die "sesi putus atau auth gagal saat apply. Periksa device manual; pre-config ada di $precfg"
  fi
  # exit != 0 pada mode exec RouterOS berarti perintah ditolak (syntax/invalid value),
  # bukan sesi putus — lanjut ke deteksi error di bawah supaya pesannya akurat.
  if [ $rc -ne 0 ] && ! is_exec_brand "$brand"; then
    rm -f "$out"; audit "config-failed" "$hostname ($ip): sesi putus saat apply (exit $rc)"
    die "sesi putus saat apply (exit $rc). Periksa device manual; pre-config ada di $precfg"
  fi
  local errors
  errors=$(grep -E "$(err_pattern "$brand")" "$out" | head -10)
  if [ -z "$errors" ] && [ $rc -ne 0 ] && is_exec_brand "$brand"; then
    # RouterOS kadang hanya mencetak satu baris error tanpa prefix yang dikenal
    errors=$(grep -vE '^\s*$' "$out" | head -5)
  fi

  # 3) post-check: tarik config baru, verifikasi isi script ada
  local newcfg="$BACKUP_DIR/${hostname}-${ts}-post.cfg"
  pull_config "$ip" "$port" "$user" "$pass" "$secret" "$brand" "$newcfg" || true

  MISSING=(); UNCHECKED=()
  if is_exec_brand "$brand"; then verify_mikrotik "$newcfg" "$eff_script"; else verify_exact "$newcfg" "$script"; fi
  rm -f "$eff_script"

  echo "--- hasil eksekusi ---"
  if [ -n "$errors" ]; then echo "Error dari device:"; echo "$errors"; else echo "Error dari device: tidak ada"; fi
  echo "Baris tidak terverifikasi di config baru: ${#MISSING[@]}"
  [ ${#MISSING[@]} -gt 0 ] && printf '  - %s\n' "${MISSING[@]}"
  echo "Baris perlu cek manual (heuristik): ${#UNCHECKED[@]}"
  if [ ${#UNCHECKED[@]} -gt 0 ] && [ ${#UNCHECKED[@]} -le 5 ]; then printf '  - %s\n' "${UNCHECKED[@]}"; fi

  if [ -z "$errors" ] && [ ${#MISSING[@]} -eq 0 ] && [ -s "$newcfg" ]; then
    db_write '(.devices[] | select(.id==$id)).config_list = $cfg
              | (.devices[] | select(.id==$id)).last_sync = (now|todate)' \
             --argjson id "$id" --rawfile cfg "$newcfg"
    audit "config-ok" "$hostname ($ip): $reason"
    echo "STATUS: SUKSES — config_list diperbarui"
    return 0
  else
    audit "config-failed" "$hostname ($ip): $reason"
    echo "STATUS: GAGAL — config_list TIDAK diubah. Pre-config: $precfg"
    return 1
  fi
}

cmd_config() {
  local ref="" script="" rollback="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --script) script=$2; shift 2;;
      --rollback) rollback=$2; shift 2;;
      --reason) reason=$2; shift 2;;
      *) [ -z "$ref" ] && ref=$1 || die "argumen tak dikenal: $1"; shift;;
    esac
  done
  [ -n "$ref" ] && [ -n "$script" ] || die "usage: ntn config <ref> --script <file> [--rollback <file>] [--reason <teks>]"
  [ -n "$reason" ] || reason="(tanpa keterangan)"
  local id; id=$(resolve_ref "$ref"); [ -n "$id" ] || die "device tidak ditemukan: $ref"
  local hostname; hostname=$(device_by_id "$id" | jq -r '.hostname')
  local ts; ts=$(date +%Y%m%d-%H%M%S)
  local rbfile="$BACKUP_DIR/${hostname}-${ts}-rollback.cmd"

  if [ -n "$rollback" ]; then
    [ -s "$rollback" ] || die "file rollback tidak ada/kosong: $rollback"
    cp "$rollback" "$rbfile"
  else
    : > "$rbfile"
  fi

  if apply_config "$id" "$script" "$reason"; then
    if [ -n "$rollback" ]; then
      db_write '(.devices[] | select(.id==$id)).check_point = $rb' --argjson id "$id" --rawfile rb "$rbfile"
    fi
    db_write '.checkpoints = (.checkpoints + [{ts:(now|todate), hostname:$h, reason:$r, rollback_file:$f}])[-200:]' \
             --arg h "$hostname" --arg r "$reason" --arg f "$rbfile"
    if [ -n "$rollback" ]; then
      echo "Script rollback disimpan → kolom check_point + $rbfile"
    else
      echo "PERHATIAN: tidak ada script rollback; hanya snapshot pre-change di backups/"
    fi
  else
    die "penerapan gagal — perbaiki script lalu coba lagi, atau pulihkan manual dari $precfg"
  fi
}

cmd_rollback() {
  [ $# -ge 1 ] || die "usage: ntn rollback <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device tidak ditemukan: $1"
  local rb hostname
  rb=$(device_by_id "$id" | jq -r '.check_point')
  hostname=$(device_by_id "$id" | jq -r '.hostname')
  [ -n "$rb" ] || die "check_point kosong untuk $hostname — tidak ada yang bisa di-rollback"
  local rbtmp; rbtmp=$(mktemp "$TMPBASE/ntn.rb.XXXXXX")
  printf '%s\n' "$rb" > "$rbtmp"
  echo "Menjalankan rollback untuk $hostname ..."
  if apply_config "$id" "$rbtmp" "ROLLBACK"; then
    db_write '(.devices[] | select(.id==$id)).check_point = ""' --argjson id "$id"
    audit "rollback" "$hostname"
    echo "STATUS: ROLLBACK SUKSES — check_point dikosongkan"
  else
    rm -f "$rbtmp"
    die "rollback gagal — periksa manual; snapshot ada di $BACKUP_DIR"
  fi
  rm -f "$rbtmp"
}

cmd_checkpoints() {
  [ $# -ge 1 ] || die "usage: ntn checkpoints <ref>"
  local id; id=$(resolve_ref "$1"); [ -n "$id" ] || die "device tidak ditemukan: $1"
  local hostname; hostname=$(device_by_id "$id" | jq -r '.hostname')
  local n; n=$(jq --arg h "$hostname" '[.checkpoints[] | select(.hostname==$h)] | length' "$DB")
  echo "Riwayat checkpoint $hostname ($n entri, terbaru terakhir):"
  jq -r --arg h "$hostname" '[.checkpoints[] | select(.hostname==$h)][-10:][] | "  \(.ts) — \(.reason)\n    rollback file: \(.rollback_file)"' "$DB"
}

cmd_audit() {
  local n=${1:-20}
  jq -r --argjson n "$n" '.audit[-$n:][] | "\(.ts)  \(.action)  \(.detail)"' "$DB"
}

usage() {
  cat <<'EOF'
ntn — NTnRoute.AI device engine
  ntn list                                   daftar device bernomor
  ntn add <IP> <Port> <User> <Pass> <Type> <Brand> [Secret]
                                             tes koneksi dulu, ambil hostname+config, baru simpan
  ntn show <ref> [--reveal]                  detail device (ref: nomor|id|ip|hostname)
  ntn remove <nomor|id>                      hapus device
  ntn ping <ref>                             tes ICMP 3 paket
  ntn exec <ref> <cmd> [cmd2 ...]            jalankan perintah CLI (read-only disarankan)
  ntn sync <ref|all>                         tarik config -> config_list + backup
  ntn config <ref> --script <file> [--rollback <file>] [--reason <teks>]
                                             snapshot pre -> apply -> verifikasi -> update DB
  ntn rollback <ref>                         terapkan script check_point
  ntn checkpoints <ref>                      riwayat checkpoint
  ntn audit [N]                              N entri audit terakhir (default 20)

Brand: Cisco, Huawei, Aruba, Arista, Ruijie, Juniper, Mikrotik.
Mikrotik -> exec-mode (ssh -T, /export, tanpa write memory).
Brand lain -> CLI interaktif (ssh -tt) dengan paginasi + save otomatis.
EOF
}

main() {
  local sub=${1:-help}; shift || true
  case "$sub" in
    list) cmd_list;;
    add) cmd_add "$@";;
    show) cmd_show "$@";;
    remove) cmd_remove "$@";;
    ping) cmd_ping "$@";;
    exec) cmd_exec "$@";;
    sync) cmd_sync "$@";;
    config) cmd_config "$@";;
    rollback) cmd_rollback "$@";;
    checkpoints) cmd_checkpoints "$@";;
    audit) cmd_audit "$@";;
    help|--help|-h) usage;;
    *) usage; die "perintah tidak dikenal: $sub";;
  esac
}

main "$@"
