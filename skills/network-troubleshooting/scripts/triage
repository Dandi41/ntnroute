#!/usr/bin/env bash
# triage — reads `show` output captured from a device and reports findings by OSI layer.
# bash+awk port of triage.py (same CLI, same output, no Python).
#
# It never touches a device. You capture, it reads:
#
#   ntn exec 1 'show interfaces' 'show ip route' 'show ip arp' > out.txt
#   triage out.txt --mgmt-ip 10.0.0.5
#
#   ntn exec 3 '/interface print detail' '/ip route print' > out3.txt
#   triage out3.txt --mgmt-ip 10.0.0.6
#
# Multiple files are fine. Vendor is detected from the text (--vendor overrides).
#
# Exit 1 when a layer-1/2 finding is present that a config change cannot fix
# (cabling, duplex, errors climbing) — that is the "stop, this is hardware" gate.
# Exit 0 otherwise.
#
# Counter warning: absolute error counts prove nothing. Re-capture after traffic
# and diff; the tool prints the numbers so you can compare, and says so.
set -o pipefail

usage() { echo "usage: triage <file>... [--vendor cisco|mikrotik] [--mgmt-ip IP]" >&2; exit 2; }

files=() vendor="" mgmt=""
while [ $# -gt 0 ]; do
  case "$1" in
    --vendor) [ $# -ge 2 ] || usage; vendor=$2; shift 2;;
    --mgmt-ip) [ $# -ge 2 ] || usage; mgmt=$2; shift 2;;
    -h|--help|--*) usage;;
    *) files+=("$1"); shift;;
  esac
done
[ ${#files[@]} -ge 1 ] || usage
case "$vendor" in ""|cisco|mikrotik) ;; *) usage;; esac
for f in "${files[@]}"; do [ -r "$f" ] || { echo "triage: cannot read: $f" >&2; exit 2; }; done

AWK_BIN=$(command -v gawk || command -v awk)
[ -n "$AWK_BIN" ] || { echo "triage: no awk found" >&2; exit 2; }
# the parser needs gawk's 3-argument match(); probe rather than assume
"$AWK_BIN" 'BEGIN { match("ab", /(b)/, m) }' 2>/dev/null || {
  echo "triage: this awk lacks 3-argument match() — install gawk" >&2; exit 2
}
export TRIAGE_VENDOR="$vendor" TRIAGE_MGMT="$mgmt" TRIAGE_NFILES="${#files[@]}"

AWKPROG=$(cat <<'AWKEOF'
# ---- findings store -------------------------------------------------------
function add(sev, layer, rule, why, ev) {
  nf++
  f_sev[nf]=sev; f_layer[nf]=layer; f_rule[nf]=rule; f_why[nf]=why; f_ev[nf]=ev
}
# first match of ^\s*(\d+) <label>\b inside a chunk, else 0
function num(chunk, label,    i, m, n, L) {
  n = split(chunk, L, "\n")
  for (i = 1; i <= n; i++)
    if (match(L[i], "^[[:blank:]]*([0-9]+) " label "([^[:alnum:]_]|$)", m))
      return m[1] + 0
  return 0
}
function strip_leading_sp(s) { sub(/^[[:blank:]]+/, "", s); return s }

function analyze_iface(name, chunk, admin, proto,    crc, errs, resets, late, drops, i, l, m, dm, n, L) {
  if (admin == "administratively down") {
    add("WARN", "L1", "iface-admin-down",
        name ": shut by config — link will never come up until `no shutdown`", name)
  } else if (proto == "down") {
    add("CRIT", "L1", "iface-protocol-down",
        name ": link up but line protocol down — cabling/SFP/speed mismatch, or " \
             "peer not enabled. Config alone cannot fix this", name)
  }
  errs   = num(chunk, "input errors")
  crc    = num(chunk, "CRC")
  resets = num(chunk, "interface resets")
  # original used "late collision|late collisions" whose top-level | broke the
  # ^-anchor; the port keeps the anchored intent and accepts both spellings
  late   = num(chunk, "(late collisions|late collision)")
  drops  = num(chunk, "Total output drops")
  if (crc)
    add("CRIT", "L1", "iface-crc",
        name ": " crc " CRC errors — damaged frames on the wire: cable, SFP, or " \
             "duplex mismatch. Re-capture later to confirm it is climbing",
        name " CRC=" crc)
  if (errs && !crc)
    add("WARN", "L1", "iface-input-errors",
        name ": " errs " input errors without CRC — check runts/giants, duplex, " \
             "and the peer's speed setting", name " input errors=" errs)
  if (resets)
    add("WARN", "L1", "iface-resets",
        name ": " resets " interface resets — link flapped; correlate with " \
             "`link-downs` on the peer and with power/cable events", name " resets=" resets)
  if (late)
    add("WARN", "L1", "iface-late-collisions",
        name ": " late " late collisions — classic duplex mismatch, one side " \
             "full and the other half", name " late=" late)
  if (drops)
    add("WARN", "L1", "iface-output-drops",
        name ": " drops " output drops — congestion or a speed mismatch on this " \
             "egress, not a cabling fault", name " drops=" drops)
  # duplex: line-anchored, case-insensitive, first match in chunk
  n = split(chunk, L, "\n")
  for (i = 1; i <= n; i++) {
    l = tolower(L[i])
    if (l ~ /^[[:blank:]]*(full|half)-duplex,[[:blank:]]*[0-9]+mb\/s/) {
      if (match(L[i], /[[:blank:]]*([Ff]ull|[Hh]alf)-duplex,[[:blank:]]*[0-9]+[Mm][Bb]\/s/, dm)) {
        if (tolower(dm[1]) == "half")
          add("WARN", "L1", "iface-half-duplex",
              name ": negotiated half duplex — force matching settings on both sides",
              name " " strip_leading_sp(dm[0]))
      }
      break
    }
  }
  if (MGMT != "" && index(chunk, "Internet address is " MGMT "/"))
    add("INFO", "L1", "iface-mgmt",
        name " carries the management IP " MGMT " — never touch this interface " \
             "while diagnosing; you will lose the session", name)
}

function parse_cisco(    i, m, inchunk, cname, cadmin, cproto, chunk, inc_n, inc_ip, z, k, j) {
  inchunk = 0; chunk = ""
  for (i = 1; i <= n; i++) {
    if (match(lines[i], /^([^[:space:]]+) is (up|down|administratively down), line protocol is (up|down)/, m)) {
      if (inchunk) analyze_iface(cname, chunk, cadmin, cproto)
      cname = m[1]; cadmin = m[2]; cproto = m[3]
      chunk = lines[i] "\n"; inchunk = 1
      continue
    }
    if (inchunk) chunk = chunk lines[i] "\n"
  }
  if (inchunk) analyze_iface(cname, chunk, cadmin, cproto)

  # ARP / L2-L3 boundary: exactly `Internet <ip> <f1> <f2> <f3>` to EOL
  inc_n = 0
  for (i = 1; i <= n; i++) {
    if (match(lines[i], /^Internet[[:blank:]]+([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)[[:blank:]]+([^[:space:]]+)[[:blank:]]+([^[:space:]]+)[[:blank:]]+([^[:space:]]+)[[:blank:]]+([^[:space:]]+)[[:blank:]]*$/, m)) {
      z = tolower(m[5])
      if (z == "incomplete" || z == "<incomplete>") {
        inc_n++; inc_ip[inc_n] = m[1]
      }
    }
  }
  if (inc_n > 0) {
    k = inc_ip[1]
    for (j = 2; j <= inc_n && j <= 5; j++) k = k ", " inc_ip[j]
    add("WARN", "L2", "arp-incomplete",
        inc_n " ARP entr(y/ies) unresolved — host not answering on this " \
             "segment: wrong VLAN, port isolation, or the host is simply absent", k)
  }

  # routes
  for (i = 1; i <= n; i++) {
    if (match(lines[i], /^Gateway of last resort is (.+)$/, m)) {
      if (m[1] ~ /not set/)
        add("WARN", "L3", "no-default-route",
            "no gateway of last resort — traffic to unknown destinations is dropped here",
            strip_leading_sp(m[0]))
    }
  }
}

function flush_entry(    downs, lastdown, mtu, fl, m) {
  if (!in_e) return
  fl = e_flags
  if (index(fl, "X")) {
    add("WARN", "L1", "iface-disabled",
        e_name ": disabled by config (`disable`) — enable it before chasing L2",
        e_name " flags=" (strip_leading_sp(fl) == "" ? "-" : strip_leading_sp(fl)))
  } else if (!index(fl, "R")) {
    add("CRIT", "L1", "iface-not-running",
        e_name ": not running — no link. Cable, SFP, or peer port down. " \
               "Nothing above L1 can work",
        e_name " flags=" (strip_leading_sp(fl) == "" ? "-" : strip_leading_sp(fl)))
  }
  downs = ""
  if (match(e_body, /link-downs=([0-9]+)/, m)) downs = m[1]
  if (downs != "" && downs + 0 > 0) {
    lastdown = ""
    if (match(e_body, /last-link-down-time=([^[:space:]]+ [^[:space:]]+)/, m)) lastdown = m[1]
    add("WARN", "L1", "iface-link-flaps",
        e_name ": link went down " downs "x" \
             (lastdown != "" ? ", last at " lastdown : "") \
             " — intermittent: cable, PoE budget, or a flapping peer",
        e_name " link-downs=" downs)
  }
  if (match(e_body, /actual-mtu=([0-9]+)/, m)) {
    mtu = m[1]
    if (mtu != "1500" && substr(e_name, 1, 2) != "lo")
      add("INFO", "L1", "iface-mtu",
          e_name ": actual-mtu=" mtu " — not 1500; check MTU consistency on " \
                 "the path before blaming PMTUD", e_name " mtu=" mtu)
  }
}

function parse_mikrotik(    i, m) {
  in_e = 0; e_flags = ""; e_name = ""; e_body = ""
  for (i = 1; i <= n; i++) {
    if (lines[i] ~ /^Flags:/) { flush_entry(); in_e = 0; continue }
    if (match(lines[i], /^[[:blank:]]*[0-9]+[[:blank:]]+([DXIRS ]{0,6})[[:blank:]]+name="([^"]+)"/, m)) {
      flush_entry()
      e_flags = m[1]; e_name = m[2]; e_body = ""; in_e = 1
      continue
    }
    if (in_e) e_body = e_body lines[i] "\n"
  }
  flush_entry()

  # /ip route print
  for (i = 1; i <= n; i++) {
    if (match(lines[i], /^[[:blank:]]*[0-9]+[[:blank:]]+([A-Za-z ]{0,6})[[:blank:]]+([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+)[[:blank:]]+([^[:space:]]+)[[:blank:]]+([0-9]+)/, m)) {
      if (!index(m[1], "A") && !index(m[1], "C") && !index(m[1], "d"))
        add("CRIT", "L3", "route-inactive",
            "route " m[2] " via " m[3] " is INACTIVE (no `A` flag) — the gateway is " \
            "unreachable, so this destination is dead even though the route exists",
            m[2] " gateway=" m[3] " flags=" strip_leading_sp(m[1]))
    }
  }

  # dhcp client
  if (txt ~ /status=[^[:space:]]*bound/)
    add("INFO", "L3", "dhcp-bound",
        "DHCP client has a lease — losing it changes the management IP, " \
        "so do not bounce that interface", "")
}

BEGIN { }
{ lines[NR] = $0 }
END {
  n = NR
  txt = ""
  for (i = 1; i <= n; i++) txt = txt lines[i] "\n"

  V = ENVIRON["TRIAGE_VENDOR"]
  if (V == "") {
    V = "cisco"
    for (i = 1; i <= n; i++)
      if (lines[i] ~ /^Flags:.*R - running/ || lines[i] ~ /^\/interface/ || \
          lines[i] ~ /^[[:blank:]]*[0-9]+[[:blank:]]+[RX ]+[[:blank:]]+name=/) { V = "mikrotik"; break }
  }
  MGMT = ENVIRON["TRIAGE_MGMT"]
  printf "vendor=%s files=%s mgmt_ip=%s\n", V, ENVIRON["TRIAGE_NFILES"], (MGMT == "" ? "-" : MGMT)

  if (V == "mikrotik") parse_mikrotik(); else parse_cisco()

  if (nf == 0) {
    print "  no finding — either the capture is clean or the command that would " \
          "show the fault was not included"
    exit 0
  }

  # sort by (severity, layer, original order) — stable, like the Python original
  rank["CRIT"] = 1; rank["WARN"] = 2; rank["INFO"] = 3
  lr["L1"] = 1; lr["L2"] = 2; lr["L3"] = 3
  for (i = 1; i <= nf; i++) { ord[i] = i; key[i] = rank[f_sev[i]] * 100000 + lr[f_layer[i]] * 1000 + i }
  for (i = 2; i <= nf; i++) {          # insertion sort on parallel arrays
    kv = key[i]; ov = ord[i]; j = i - 1
    while (j >= 1 && key[j] > kv) { key[j+1] = key[j]; ord[j+1] = ord[j]; j-- }
    key[j+1] = kv; ord[j+1] = ov
  }
  c["CRIT"] = 0; c["WARN"] = 0; c["INFO"] = 0
  for (i = 1; i <= nf; i++) c[f_sev[i]]++
  printf "  CRIT=%d WARN=%d INFO=%d\n", c["CRIT"], c["WARN"], c["INFO"]

  cur = ""
  for (k = 1; k <= nf; k++) {
    i = ord[k]
    if (f_layer[i] != cur) { printf "\n  -- %s --\n", f_layer[i]; cur = f_layer[i] }
    printf "  [%s] %s %s: %s\n", f_sev[i], f_layer[i], f_rule[i], f_why[i]
    if (f_ev[i] != "") printf "           %s\n", f_ev[i]
  }

  printf "\n  Reminder: error counters are only meaningful as a delta. Re-capture after " \
         "traffic and compare, otherwise an old CRC count reads as a live fault.\n"
  if (c["CRIT"] > 0) {
    print "VERDICT: L1/L2 fault present — fix the physical/link cause before any " \
          "config change. A config edit cannot repair a down link or bad cable."
    exit 1
  }
  print "VERDICT: no link-layer blocker — continue up the ladder (L2 VLAN/STP, then L3 route)."
  exit 0
}
AWKEOF
)

LC_ALL=C "$AWK_BIN" "$AWKPROG" "${files[@]}"
